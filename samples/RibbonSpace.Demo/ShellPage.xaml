<Page x:Class="RibbonSpace.Demo.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource RibbonWindowBackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- Page rail: a vertical RibbonToolBar with radio toggles. -->
    <RibbonToolBar x:Name="Rail" Orientation="Vertical" ShowLabels="False" CornerRadius="0" BorderThickness="0,0,1,0" Padding="4,8" Background="{ThemeResource RibbonChromeBackgroundBrush}">
      <RibbonToggleButton x:Name="WordRail" Id="rail.word" Label="Word (XAML)" Icon="&#xE8A5;" GroupName="pages" IsChecked="True" Tag="word" />
      <RibbonToggleButton Id="rail.excel" Label="Excel (MVVM)" Icon="&#xE80A;" GroupName="pages" Tag="excel" />
      <RibbonToggleButton Id="rail.powerpoint" Label="PowerPoint (Simplified)" Icon="&#xE7F4;" GroupName="pages" Tag="powerpoint" />
      <RibbonToggleButton Id="rail.tools" Label="Toolbars &amp; palettes" Icon="&#xE771;" GroupName="pages" Tag="tools" />
      <RibbonSeparator />
      <RibbonToggleButton Id="rail.settings" Label="Settings" Icon="&#xE713;" GroupName="pages" Tag="settings" />
    </RibbonToolBar>
    <Grid x:Name="PageHost" Grid.Column="1" />
  </Grid>
</Page>
