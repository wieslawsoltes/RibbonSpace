<UserControl x:Class="RibbonSpace.Demo.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource RibbonWindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Classic menu bar (ImageSpace / VideoSpace / CadSpace style). -->
    <RibbonMenuBar x:Name="MenuBar">
      <RibbonMenuBarItem Header="File">
        <MenuFlyoutItem Text="New..." KeyboardAcceleratorTextOverride="Ctrl+N" />
        <MenuFlyoutItem Text="Open..." KeyboardAcceleratorTextOverride="Ctrl+O" />
        <MenuFlyoutSubItem Text="Open Recent">
          <MenuFlyoutItem Text="poster.psd" />
          <MenuFlyoutItem Text="logo.svg" />
        </MenuFlyoutSubItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Save" KeyboardAcceleratorTextOverride="Ctrl+S" />
        <MenuFlyoutItem Text="Export As..." KeyboardAcceleratorTextOverride="Alt+Shift+Ctrl+W" />
      </RibbonMenuBarItem>
      <RibbonMenuBarItem Header="Edit">
        <MenuFlyoutItem Text="Undo" KeyboardAcceleratorTextOverride="Ctrl+Z" />
        <MenuFlyoutItem Text="Redo" KeyboardAcceleratorTextOverride="Shift+Ctrl+Z" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Cut" KeyboardAcceleratorTextOverride="Ctrl+X" />
        <MenuFlyoutItem Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" />
        <MenuFlyoutItem Text="Paste" KeyboardAcceleratorTextOverride="Ctrl+V" />
      </RibbonMenuBarItem>
      <RibbonMenuBarItem Header="Image">
        <MenuFlyoutItem Text="Image Size..." />
        <MenuFlyoutItem Text="Canvas Size..." />
        <ToggleMenuFlyoutItem Text="Pixel Aspect Ratio Correction" IsChecked="True" />
      </RibbonMenuBarItem>
      <RibbonMenuBarItem Header="Layer">
        <MenuFlyoutItem Text="New Layer" KeyboardAcceleratorTextOverride="Shift+Ctrl+N" />
        <MenuFlyoutItem Text="Duplicate Layer" />
      </RibbonMenuBarItem>
      <RibbonMenuBarItem Header="View">
        <ToggleMenuFlyoutItem Text="Rulers" IsChecked="True" KeyboardAcceleratorTextOverride="Ctrl+R" />
        <ToggleMenuFlyoutItem Text="Grid" />
        <ToggleMenuFlyoutItem Text="Snap" IsChecked="True" />
      </RibbonMenuBarItem>
      <RibbonMenuBarItem Header="Window">
        <ToggleMenuFlyoutItem Text="Layers" IsChecked="True" />
        <ToggleMenuFlyoutItem Text="Properties" IsChecked="True" />
      </RibbonMenuBarItem>
      <RibbonMenuBarItem Header="Help">
        <MenuFlyoutItem Text="Keyboard Shortcuts" />
        <MenuFlyoutItem Text="About" />
      </RibbonMenuBarItem>
    </RibbonMenuBar>

    <!-- Tool options bar: content follows the active tool (Photoshop / Illustrator control bar). -->
    <RibbonContextualToolBar x:Name="Options" Grid.Row="1" ActiveContext="brush" Margin="6,4">
      <RibbonToolBar RibbonContextualToolBar.Context="move" CornerRadius="6">
        <RibbonLabel Label="Move" Icon="&#xE7C2;" />
        <RibbonSeparator />
        <RibbonCheckBox Label="Auto-Select" IsChecked="True" />
        <RibbonCheckBox Label="Show Transform Controls" />
        <RibbonSeparator />
        <RibbonButton Label="Align Left" Icon="&#xE8E4;" />
        <RibbonButton Label="Align Center" Icon="&#xE8E3;" />
        <RibbonButton Label="Align Right" Icon="&#xE8E2;" />
      </RibbonToolBar>
      <RibbonToolBar RibbonContextualToolBar.Context="brush" CornerRadius="6">
        <RibbonLabel Label="Brush" Icon="&#xE771;" />
        <RibbonSeparator />
        <RibbonSpinner Label="Size:" Value="24" Minimum="1" Maximum="5000" Unit="px" InputWidth="70" />
        <RibbonSpinner Label="Hardness:" Value="80" Minimum="0" Maximum="100" Unit="%" InputWidth="62" />
        <RibbonComboBox Label="Mode" ShowLabel="True" Text="Normal" InputWidth="110">
          <x:String>Normal</x:String>
          <x:String>Multiply</x:String>
          <x:String>Screen</x:String>
          <x:String>Overlay</x:String>
        </RibbonComboBox>
        <RibbonSlider Label="Opacity" Value="100" Maximum="100" InputWidth="100" />
        <RibbonToggleButton Label="Airbrush" Icon="&#xE706;" />
        <RibbonToggleButton Label="Pressure for size" Icon="&#xEDFB;" />
        <RibbonColorPicker Label="Brush color" Icon="&#xE790;" SelectedColor="#1473E6" />
      </RibbonToolBar>
      <RibbonToolBar RibbonContextualToolBar.Context="text" CornerRadius="6">
        <RibbonLabel Label="Type" Icon="&#xE8D2;" />
        <RibbonSeparator />
        <RibbonFontComboBox Text="Inter" />
        <RibbonFontSizeComboBox Text="24" />
        <RibbonButtonGroup>
          <RibbonToggleButton Label="Bold" Icon="&#xE8DD;" />
          <RibbonToggleButton Label="Italic" Icon="&#xE8DB;" />
        </RibbonButtonGroup>
        <RibbonSegmentedControl Label="Alignment">
          <RibbonSegment Icon="&#xE8E4;" Label="Left" />
          <RibbonSegment Icon="&#xE8E3;" Label="Center" />
          <RibbonSegment Icon="&#xE8E2;" Label="Right" />
        </RibbonSegmentedControl>
      </RibbonToolBar>
    </RibbonContextualToolBar>

    <Grid Grid.Row="2" ColumnSpacing="6" Padding="6,0,6,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Two-column vertical tool palette with radio tools and split tools. -->
      <RibbonToolBar x:Name="Tools" Orientation="Vertical" Columns="2" VerticalAlignment="Top">
        <RibbonToggleButton Label="Move (V)" Icon="&#xE7C2;" GroupName="tool" Tag="move" Shortcut="V" />
        <RibbonToggleButton Label="Select (M)" Icon="&#xE8B3;" GroupName="tool" Tag="move" />
        <RibbonToggleButton Label="Brush (B)" Icon="&#xE771;" GroupName="tool" Tag="brush" IsChecked="True" />
        <RibbonToggleButton Label="Pen (P)" Icon="&#xEDFB;" GroupName="tool" Tag="brush" />
        <RibbonToggleButton Label="Eraser (E)" Icon="&#xE75C;" GroupName="tool" Tag="brush" />
        <RibbonToggleButton Label="Type (T)" Icon="&#xE8D2;" GroupName="tool" Tag="text" />
        <RibbonSeparator />
        <RibbonSplitButton Label="Rectangle" Icon="&#xE739;" Size="Small" FollowLastChoice="True">
          <MenuFlyout>
            <MenuFlyoutItem Text="Rectangle" Tag="&#xE739;" />
            <MenuFlyoutItem Text="Ellipse" Tag="&#xEA3A;" />
            <MenuFlyoutItem Text="Polygon" Tag="&#xE879;" />
            <MenuFlyoutItem Text="Line" Tag="&#xE7C9;" />
          </MenuFlyout>
        </RibbonSplitButton>
        <RibbonButton Label="Crop" Icon="&#xE7A8;" />
        <RibbonButton Label="Zoom" Icon="&#xE71E;" />
        <RibbonButton Label="Hand" Icon="&#xE7C9;" />
        <RibbonSeparator />
        <RibbonColorPicker Label="Foreground" Icon="&#xE790;" SelectedColor="#1473E6" />
        <RibbonColorPicker Label="Background" Icon="&#xE790;" SelectedColor="White" />
      </RibbonToolBar>

      <Border Grid.Column="1" CornerRadius="6" Background="#FF3A3A3A" BorderThickness="1" BorderBrush="{ThemeResource RibbonCommandBarBorderBrush}">
        <Grid>
          <Border Width="480" Height="320" Background="White" CornerRadius="2">
            <TextBlock x:Name="CanvasText" Text="Pick a tool — the options bar follows the active tool" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555555" />
          </Border>
          <!-- Horizontal command bar with overflow ("⋯") floating on the canvas. -->
          <RibbonToolBar VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" MaxWidth="360">
            <RibbonButton Label="Undo" Icon="&#xE7A7;" />
            <RibbonButton Label="Redo" Icon="&#xE7A6;" />
            <RibbonSeparator />
            <RibbonButton Label="Zoom In" Icon="&#xE8A3;" />
            <RibbonButton Label="Zoom Out" Icon="&#xE71F;" />
            <RibbonButton Label="Fit" Icon="&#xE740;" />
            <RibbonSeparator />
            <RibbonToggleButton Label="Grid" Icon="&#xE80A;" />
            <RibbonToggleButton Label="Snap" Icon="&#xE8AD;" IsChecked="True" />
            <RibbonToggleButton Label="Rulers" Icon="&#xECC6;" />
            <RibbonButton Label="Rotate" Icon="&#xE7AD;" />
            <RibbonButton Label="Flip" Icon="&#xE8AB;" />
            <RibbonButton Label="Export" Icon="&#xEDE1;" />
          </RibbonToolBar>
        </Grid>
      </Border>

      <!-- Activity rail (panel launchers) with labels. -->
      <RibbonToolBar Grid.Column="2" Orientation="Vertical" VerticalAlignment="Top">
        <RibbonToggleButton Label="Layers" Icon="&#xE81E;" GroupName="panel" IsChecked="True" />
        <RibbonToggleButton Label="Properties" Icon="&#xE713;" GroupName="panel" />
        <RibbonToggleButton Label="History" Icon="&#xE81C;" GroupName="panel" />
        <RibbonToggleButton Label="Libraries" Icon="&#xE8F1;" GroupName="panel" />
      </RibbonToolBar>
    </Grid>

    <RibbonStatusBar Grid.Row="3">
      <TextBlock x:Name="ToolStatus" Text="Brush tool" VerticalAlignment="Center" />
      <TextBlock Text="1920 × 1080 px · RGB/8" VerticalAlignment="Center" />
      <RibbonStatusBar.EndItems>
        <RibbonZoomControl Value="66" />
      </RibbonStatusBar.EndItems>
    </RibbonStatusBar>
  </Grid>
</UserControl>
