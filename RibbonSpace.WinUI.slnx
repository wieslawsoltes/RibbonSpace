<Solution>
  <!-- Any CPU builds the apps for the machine's architecture; x64 / ARM64 select it explicitly. -->
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/src/">
    <Project Path="src/RibbonSpace.Core/RibbonSpace.Core.csproj">
      <Platform Project="Any CPU" />
    </Project>
    <Project Path="src/RibbonSpace.WinUI/RibbonSpace.WinUI.csproj">
      <Platform Project="Any CPU" />
    </Project>
  </Folder>
  <Folder Name="/samples/">
    <Project Path="samples/RibbonSpace.WinUI.Demo/RibbonSpace.WinUI.Demo.csproj">
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/RibbonSpace.Core.Tests/RibbonSpace.Core.Tests.csproj">
      <Platform Project="Any CPU" />
    </Project>
    <Project Path="tests/RibbonSpace.WinUI.RuntimeTests/RibbonSpace.WinUI.RuntimeTests.csproj">
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
    </Project>
  </Folder>
</Solution>
