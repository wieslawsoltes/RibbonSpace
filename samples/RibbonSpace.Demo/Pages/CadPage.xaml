      <RibbonTab Header="Manage" Id="manage" KeyTip="M">
        <RibbonGroup Header="Action Recorder" Id="actionRecorder" Icon="{cad:CadIcon Name=ActionRecorder}">
          <RibbonToggleButton Id="record" Label="Record" Icon="{cad:CadIcon Name=ActionRecorder}" Size="Large" ScreenTip="Starts the Action Recorder.&#x0a;&#x0a;ACTRECORD" />
          <RibbonButton Id="play" Label="Play" Icon="&#xE768;" Size="Medium" />
          <RibbonButton Id="insertMessage" Label="Insert Message" Icon="{cad:CadIcon Name=MultilineText}" Size="Medium" />
        </RibbonGroup>
        <RibbonGroup Header="Customization" Id="customization" Icon="{cad:CadIcon Name=Customize}">
          <RibbonButton Id="userInterface" Label="User&#x0a;Interface" Icon="{cad:CadIcon Name=Customize}" Size="Large" ScreenTip="Manages customized user interface elements.&#x0a;&#x0a;CUI" />
          <RibbonButton Id="toolPalettesCustomize" Label="Tool Palettes" Icon="{cad:CadIcon Name=Workspace}" Size="Medium" />
          <RibbonButton Id="importCustomization" Label="Import" Icon="{cad:CadIcon Name=Open}" Size="Medium" />
          <RibbonButton Id="editAliases" Label="Edit Aliases" Icon="{cad:CadIcon Name=CommandLine}" Size="Medium" />
        </RibbonGroup>
        <RibbonGroup Header="Applications" Id="applications" Icon="{cad:CadIcon Name=LoadApplication}">
          <RibbonButton Id="loadApplication" Label="Load&#x0a;Application" Icon="{cad:CadIcon Name=LoadApplication}" Size="Large" ScreenTip="Loads and unloads applications.&#x0a;&#x0a;APPLOAD" />
          <RibbonButton Id="runScript" Label="Run Script" Icon="{cad:CadIcon Name=CommandLine}" Size="Medium" />
          <RibbonButton Id="scriptEditor" Label="Script Editor" Icon="{cad:CadIcon Name=EditPolyline}" Size="Medium" />
        </RibbonGroup>
        <RibbonGroup Header="CAD Standards" Id="cadStandards" Icon="{cad:CadIcon Name=QuickSelect}">
          <RibbonButton Id="checkStandards" Label="Check" Icon="{cad:CadIcon Name=QuickSelect}" Size="Medium" />
          <RibbonButton Id="configureStandards" Label="Configure" Icon="{cad:CadIcon Name=Customize}" Size="Medium" />
          <RibbonButton Id="layerTranslator" Label="Layer Translator" Icon="{cad:CadIcon Name=MatchLayer}" Size="Medium" />
        </RibbonGroup>
        <RibbonGroup Header="Cleanup" Id="cleanup" Icon="{cad:CadIcon Name=Purge}">
          <RibbonButton Id="purge" Label="Purge" Icon="{cad:CadIcon Name=Purge}" Size="Large" ScreenTip="Removes unused items from the drawing.&#x0a;&#x0a;PURGE" />
          <RibbonButton Id="overkill" Label="Delete Duplicates" Icon="{cad:CadIcon Name=Erase}" Size="Medium" />
          <RibbonButton Id="units" Label="Units" Icon="{cad:CadIcon Name=Units}" Size="Medium" />
        </RibbonGroup>
      </RibbonTab>

      <!-- ============================ OUTPUT ============================ -->
      <RibbonTab Header="Output" Id="output" KeyTip="O">
        <RibbonGroup Header="Plot" Id="plotGroup" Icon="{cad:CadIcon Name=Plot}">
          <RibbonButton Id="plot" Label="Plot" Icon="{cad:CadIcon Name=Plot}" Size="Large" Shortcut="Ctrl+P" ScreenTip="Plots a drawing to a plotter, printer or file.&#x0a;&#x0a;PLOT" />
          <RibbonButton Id="batchPlot" Label="Batch Plot" Icon="{cad:CadIcon Name=BatchPlot}" Size="Large" />
          <RibbonButton Id="pageSetup" Label="Page Setup Manager" Icon="{cad:CadIcon Name=PageSetup}" Size="Medium" />
          <RibbonButton Id="plotterManager" Label="Plotter Manager" Icon="{cad:CadIcon Name=Plot}" Size="Medium" />
          <RibbonButton Id="preview" Label="Preview" Icon="{cad:CadIcon Name=ZoomWindow}" Size="Medium" />
        </RibbonGroup>
        <RibbonGroup Header="Export to DWF/PDF" Id="exportGroup" Icon="{cad:CadIcon Name=ExportPdf}">
          <RibbonSplitButton Id="exportSplit" Label="Export" Icon="{cad:CadIcon Name=ExportPdf}" Size="Large" FollowLastChoice="True">
            <MenuFlyout>
              <MenuFlyoutItem Text="PDF" Tag="{cad:CadIcon Name=ExportPdf}" />
              <MenuFlyoutItem Text="DWF" Tag="{cad:CadIcon Name=Publish}" />
              <MenuFlyoutItem Text="DWFx" Tag="{cad:CadIcon Name=Publish}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonComboBox Id="exportExtents" Label="Export:" IsEditable="False" InputWidth="110" Text="Display">
            <x:String>Display</x:String>
            <x:String>Extents</x:String>
            <x:String>Window</x:String>
          </RibbonComboBox>
          <RibbonComboBox Id="exportPageSetup" Label="Page Setup:" IsEditable="False" InputWidth="110" Text="Current">
            <x:String>Current</x:String>
            <x:String>Override</x:String>
          </RibbonComboBox>
          <RibbonButton Id="exportPreview" Label="Preview" Icon="{cad:CadIcon Name=ZoomWindow}" Size="Medium" />
        </RibbonGroup>
        <RibbonGroup Header="Publish" Id="publishGroup" Icon="{cad:CadIcon Name=Publish}">
          <RibbonButton Id="publishButton" Label="Publish" Icon="{cad:CadIcon Name=Publish}" Size="Large" />
          <RibbonButton Id="print3d" Label="3D Print" Icon="{cad:CadIcon Name=Box}" Size="Large" />
        </RibbonGroup>
      </RibbonTab>

      <!-- ============================ COLLABORATE ============================ -->
      <RibbonTab Header="Collaborate" Id="collaborate" KeyTip="C">
        <RibbonGroup Header="Share" Id="share" Icon="{cad:CadIcon Name=Share}">
          <RibbonButton Id="shareDrawing" Label="Share" Icon="{cad:CadIcon Name=Share}" Size="Large" ScreenTip="Shares a copy of the drawing with others." />
          <RibbonButton Id="sharedViews" Label="Shared Views" Icon="{cad:CadIcon Name=NamedViews}" Size="Large" />
          <RibbonButton Id="pushToDocs" Label="Push to Cloud" Icon="{cad:CadIcon Name=Publish}" Size="Medium" />
        </RibbonGroup>
        <RibbonGroup Header="Compare" Id="compare" Icon="{cad:CadIcon Name=Compare}">
          <RibbonButton Id="dwgCompare" Label="DWG Compare" Icon="{cad:CadIcon Name=Compare}" Size="Large" ScreenTip="Highlights the differences between two revisions of a drawing.&#x0a;&#x0a;COMPARE" />
          <RibbonButton Id="xrefCompare" Label="Xref Compare" Icon="{cad:CadIcon Name=Attach}" Size="Large" />
        </RibbonGroup>
        <RibbonGroup Header="Markup" Id="collaborateMarkup" Icon="{cad:CadIcon Name=RevisionCloud}">
          <RibbonButton Id="markupImport" Label="Markup Import" Icon="{cad:CadIcon Name=ImportPdf}" Size="Large" />
          <RibbonButton Id="markupAssist" Label="Markup Assist" Icon="{cad:CadIcon Name=RevisionCloud}" Size="Large" />
        </RibbonGroup>
      </RibbonTab>

      <!-- ============================ CONTEXTUAL: TEXT EDITOR ============================ -->
      <RibbonTab Header="Text Editor" Id="textEditorTab" ContextualGroupId="textEditor" KeyTip="X">
        <RibbonGroup Header="Style" Id="teStyle" Icon="{cad:CadIcon Name=TextStyle}">
          <RibbonGallery Id="teStyleGallery" Label="Text Style" Icon="{cad:CadIcon Name=TextStyle}" MaxColumns="3" MinColumns="2" ItemWidth="64" ItemHeight="50">
            <RibbonGalleryItem Label="Standard" PreviewText="AaBb" PreviewFontSize="15" />
            <RibbonGalleryItem Label="Annotative" PreviewText="AaBb" PreviewFontSize="15" PreviewFontStyle="Italic" />
            <RibbonGalleryItem Label="Titles" PreviewText="AaBb" PreviewFontSize="17" PreviewFontWeight="Bold" />
          </RibbonGallery>
          <RibbonStackPanel Orientation="Vertical" Spacing="2">
            <RibbonToggleButton Id="teAnnotative" Label="Annotative" Icon="{cad:CadIcon Name=AnnotationScale}" Size="Medium" />
            <RibbonComboBox Id="teHeight" Icon="{cad:CadIcon Name=SingleLineText}" IsEditable="True" InputWidth="90" Text="2.5">
              <x:String>1.8</x:String>
              <x:String>2.5</x:String>
              <x:String>3.5</x:String>
              <x:String>5</x:String>
            </RibbonComboBox>
            <RibbonButton Id="teMask" Label="Mask" Icon="{cad:CadIcon Name=Region}" Size="Medium" />
          </RibbonStackPanel>
        </RibbonGroup>
        <RibbonGroup Header="Formatting" Id="teFormatting" Icon="&#xE8D2;" ItemsLayout="Rows" RowCount="2">
          <RibbonStackPanel>
            <RibbonButtonGroup>
              <RibbonToggleButton Id="teBold" Label="Bold" Icon="&#xE8DD;" Shortcut="Ctrl+B" />
              <RibbonToggleButton Id="teItalic" Label="Italic" Icon="&#xE8DB;" Shortcut="Ctrl+I" />
              <RibbonToggleButton Id="teUnderline" Label="Underline" Icon="&#xE8DC;" Shortcut="Ctrl+U" />
              <RibbonToggleButton Id="teStrike" Label="Strikethrough" Icon="&#xEDE0;" />
            </RibbonButtonGroup>
            <RibbonFontComboBox Id="teFont" Text="Arial" InputWidth="130" />
          </RibbonStackPanel>
          <RibbonStackPanel>
            <RibbonComboBox Id="teColor" IsEditable="False" InputWidth="110" ItemTemplate="{StaticResource ColorItemTemplate}" SelectionBoxTemplate="{StaticResource ColorItemTemplate}" x:Name="TextColorCombo" />
            <RibbonButton Id="teClearFormatting" Label="Clear Formatting" Icon="&#xE8E6;" Size="Small" />
            <RibbonButton Id="teMatch" Label="Match" Icon="{cad:CadIcon Name=MatchProperties}" Size="Small" />
          </RibbonStackPanel>
        </RibbonGroup>
        <RibbonGroup Header="Paragraph" Id="teParagraph" Icon="&#xE8E4;">
          <RibbonDropDownButton Id="teJustification" Label="Justification" Icon="&#xE8E4;" Size="Large">
            <RibbonDropDownButton.Flyout>
              <MenuFlyout>
                <RadioMenuFlyoutItem Text="Top Left TL" GroupName="just" IsChecked="True" />
                <RadioMenuFlyoutItem Text="Top Center TC" GroupName="just" />
                <RadioMenuFlyoutItem Text="Middle Center MC" GroupName="just" />
                <RadioMenuFlyoutItem Text="Bottom Right BR" GroupName="just" />
              </MenuFlyout>
            </RibbonDropDownButton.Flyout>
          </RibbonDropDownButton>
          <RibbonButtonGroup>
            <RibbonToggleButton Id="teLeft" Label="Left" Icon="&#xE8E4;" GroupName="teAlign" IsChecked="True" />
            <RibbonToggleButton Id="teCenter" Label="Center" Icon="&#xE8E3;" GroupName="teAlign" />
            <RibbonToggleButton Id="teRight" Label="Right" Icon="&#xE8E2;" GroupName="teAlign" />
          </RibbonButtonGroup>
          <RibbonDropDownButton Id="teBullets" Label="Bullets and Numbering" Icon="&#xE8FD;" Size="Small" />
          <RibbonDropDownButton Id="teLineSpacing" Label="Line Spacing" Icon="&#xE9E9;" Size="Small" />
        </RibbonGroup>
        <RibbonGroup Header="Insert" Id="teInsert" Icon="{cad:CadIcon Name=Field}">
          <RibbonDropDownButton Id="teColumns" Label="Columns" Icon="{cad:CadIcon Name=Table}" Size="Large" />
          <RibbonDropDownButton Id="teSymbol" Label="Symbol" Icon="Ø" Size="Large">
            <RibbonDropDownButton.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Degrees %%d  °" />
                <MenuFlyoutItem Text="Plus/Minus %%p  ±" />
                <MenuFlyoutItem Text="Diameter %%c  Ø" />
                <MenuFlyoutItem Text="Centerline  ℄" />
              </MenuFlyout>
            </RibbonDropDownButton.Flyout>
          </RibbonDropDownButton>
          <RibbonButton Id="teField" Label="Field" Icon="{cad:CadIcon Name=Field}" Size="Large" />
        </RibbonGroup>
        <RibbonGroup Header="Spell Check" Id="teSpell" Icon="&#xE8FB;">
          <RibbonToggleButton Id="teSpellCheck" Label="Spell Check" Icon="&#xE8FB;" Size="Large" IsChecked="True" />
        </RibbonGroup>
        <RibbonGroup Header="Tools" Id="teTools" Icon="{cad:CadIcon Name=Search}">
          <RibbonButton Id="teFind" Label="Find &amp;&#x0a;Replace" Icon="{cad:CadIcon Name=Search}" Size="Large" Shortcut="Ctrl+R" />
        </RibbonGroup>
        <RibbonGroup Header="Options" Id="teOptions" Icon="&#xE713;">
          <RibbonButton Id="teMore" Label="More" Icon="&#xE712;" Size="Medium" />
          <RibbonToggleButton Id="teRuler" Label="Ruler" Icon="{cad:CadIcon Name=AnnotationScale}" Size="Medium" IsChecked="True" />
          <RibbonButton Id="teUndo" Label="Undo" Icon="{cad:CadIcon Name=Undo}" Size="Small" />
          <RibbonButton Id="teRedo" Label="Redo" Icon="{cad:CadIcon Name=Redo}" Size="Small" />
        </RibbonGroup>
        <RibbonGroup Header="Close" Id="teClose" Icon="{cad:CadIcon Name=Close}">
          <RibbonButton x:Name="CloseTextEditor" Id="closeTextEditor" Label="Close&#x0a;Text Editor" Icon="{cad:CadIcon Name=CloseEditor}" Size="Large" KeyTip="C" />
        </RibbonGroup>
      </RibbonTab>

      <!-- ============================ CONTEXTUAL: HATCH CREATION ============================ -->
      <RibbonTab Header="Hatch Creation" Id="hatchCreationTab" ContextualGroupId="hatchCreation" KeyTip="W">
        <RibbonGroup Header="Boundaries" Id="hcBoundaries" Icon="{cad:CadIcon Name=Boundary}">
          <RibbonButton Id="hcPickPoints" Label="Pick Points" Icon="{cad:CadIcon Name=Boundary}" Size="Large" />
          <RibbonButton Id="hcSelect" Label="Select" Icon="{cad:CadIcon Name=QuickSelect}" Size="Medium" />
          <RibbonButton Id="hcRemove" Label="Remove" Icon="{cad:CadIcon Name=Erase}" Size="Medium" />
          <RibbonButton Id="hcRecreate" Label="Recreate" Icon="{cad:CadIcon Name=Redo}" Size="Medium" />
        </RibbonGroup>
        <RibbonGroup Header="Pattern" Id="hcPattern" Icon="{cad:CadIcon Name=Hatch}" ReductionOrder="1">
          <RibbonGallery x:Name="HatchGallery" Id="hcPatternGallery" Label="Pattern" Icon="{cad:CadIcon Name=Hatch}" MaxColumns="6" MinColumns="3" Rows="1" ItemWidth="50" ItemHeight="50" ShowItemLabels="False">
            <RibbonGalleryItem Label="SOLID" Icon="{cad:CadIcon Name=HatchSolid}" />
            <RibbonGalleryItem Label="ANSI31" Icon="{cad:CadIcon Name=HatchAnsi31}" />
            <RibbonGalleryItem Label="ANSI37" Icon="{cad:CadIcon Name=HatchAnsi37}" />
            <RibbonGalleryItem Label="AR-BRSTD" Icon="{cad:CadIcon Name=HatchBrick}" />
            <RibbonGalleryItem Label="AR-CONC" Icon="{cad:CadIcon Name=HatchConcrete}" />
            <RibbonGalleryItem Label="GRAVEL" Icon="{cad:CadIcon Name=HatchGravel}" />
            <RibbonGalleryItem Label="HONEY" Icon="{cad:CadIcon Name=HatchHoney}" />
            <RibbonGalleryItem Label="NET" Icon="{cad:CadIcon Name=HatchNet}" />
            <RibbonGalleryItem Label="GR_LINEAR" Icon="{cad:CadIcon Name=HatchGradient}" />
          </RibbonGallery>
        </RibbonGroup>
        <RibbonGroup Header="Properties" Id="hcProperties" Icon="{cad:CadIcon Name=Color}">
          <RibbonStackPanel Orientation="Vertical" Spacing="2">
            <RibbonComboBox Id="hcType" Icon="{cad:CadIcon Name=Hatch}" IsEditable="False" InputWidth="110" Text="Pattern">
              <x:String>Solid</x:String>
              <x:String>Gradient</x:String>
              <x:String>Pattern</x:String>
              <x:String>User defined</x:String>
            </RibbonComboBox>
            <RibbonComboBox Id="hcColor" Icon="{cad:CadIcon Name=Color}" IsEditable="False" InputWidth="110" ItemTemplate="{StaticResource ColorItemTemplate}" SelectionBoxTemplate="{StaticResource ColorItemTemplate}" x:Name="HatchColorCombo" />
            <RibbonComboBox Id="hcBackground" Icon="{cad:CadIcon Name=Gradient}" IsEditable="False" InputWidth="110" Text="None">
              <x:String>None</x:String>
              <x:String>ByLayer</x:String>
            </RibbonComboBox>
          </RibbonStackPanel>
          <RibbonStackPanel Orientation="Vertical" Spacing="2">
            <RibbonSlider Id="hcTransparency" Label="Transparency" Minimum="0" Maximum="90" Value="0" InputWidth="96" />
            <RibbonSpinner Id="hcAngle" Label="Angle" Value="0" Minimum="0" Maximum="360" Increment="15" Unit="°" InputWidth="70" />
            <RibbonSpinner Id="hcScale" Label="Scale" Value="1" Minimum="0.01" Maximum="1000" Increment="0.25" Format="0.00" InputWidth="70" />
          </RibbonStackPanel>
        </RibbonGroup>
        <RibbonGroup Header="Origin" Id="hcOrigin" Icon="{cad:CadIcon Name=Model}">
          <RibbonButton Id="hcSetOrigin" Label="Set Origin" Icon="{cad:CadIcon Name=Model}" Size="Large" />
        </RibbonGroup>
        <RibbonGroup Header="Options" Id="hcOptions" Icon="{cad:CadIcon Name=MatchProperties}" IsDialogLauncherVisible="True">
          <RibbonToggleButton Id="hcAssociative" Label="Associative" Icon="{cad:CadIcon Name=Join}" Size="Large" IsChecked="True" />
          <RibbonToggleButton Id="hcAnnotative" Label="Annotative" Icon="{cad:CadIcon Name=AnnotationScale}" Size="Large" />
          <RibbonSplitButton Id="hcMatch" Label="Match Properties" Icon="{cad:CadIcon Name=MatchProperties}" Size="Large" />
        </RibbonGroup>
        <RibbonGroup Header="Close" Id="hcClose" Icon="{cad:CadIcon Name=Close}">
          <RibbonButton x:Name="CloseHatch" Id="closeHatchCreation" Label="Close&#x0a;Hatch Creation" Icon="{cad:CadIcon Name=CloseEditor}" Size="Large" KeyTip="C" />
        </RibbonGroup>
      </RibbonTab>
    </Ribbon>

    <!-- ============================ FILE TABS ============================ -->
    <Grid x:Name="FileTabsRow" Grid.Row="2" Height="30" Background="{ThemeResource RibbonWindowBackgroundBrush}" Padding="4,4,4,0">
      <StackPanel x:Name="FileTabs" Orientation="Horizontal" Spacing="2" />
    </Grid>

    <!-- ============================ DRAWING AREA ============================ -->
    <Grid x:Name="DrawingArea" Grid.Row="3">
      <cad:CadDrawingCanvas x:Name="Canvas" />

      <!-- In-place multiline text editor shown with the Text Editor contextual tab. -->
      <Canvas x:Name="MTextLayer" Visibility="Collapsed" IsHitTestVisible="False">
        <Grid x:Name="MTextEditor">
          <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border x:Name="MTextRuler" Background="#E6EAEF" BorderBrush="#8C97A5" BorderThickness="1">
            <Path x:Name="MTextTicks" Stroke="#4E5866" StrokeThickness="1" Data="M0,6 L0,11 M10,8 L10,11 M20,8 L20,11 M30,8 L30,11 M40,6 L40,11 M50,8 L50,11 M60,8 L60,11 M70,8 L70,11 M80,6 L80,11 M90,8 L90,11 M100,8 L100,11 M110,8 L110,11 M120,6 L120,11 M130,8 L130,11 M140,8 L140,11 M150,8 L150,11 M160,6 L160,11 M170,8 L170,11 M180,8 L180,11 M190,8 L190,11 M200,6 L200,11 M210,8 L210,11 M220,8 L220,11 M230,8 L230,11 M240,6 L240,11 M250,8 L250,11 M260,8 L260,11 M270,8 L270,11 M280,6 L280,11" />
          </Border>
          <Rectangle x:Name="MTextFrame" Grid.Row="1" StrokeThickness="1" StrokeDashArray="4,3" />
          <StackPanel Grid.Row="1" Margin="6,4" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock x:Name="MTextText" Text="Open-plan living area, oak floor" FontFamily="Arial" FontSize="13" />
            <Rectangle x:Name="MTextCaret" Width="1.5" Height="15" Margin="1,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Canvas>

      <!-- Viewport controls -->
      <TextBlock x:Name="ViewportLabel" Text="[–][Top][2D Wireframe]" Margin="10,6,0,0" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />

      <!-- UCS icon -->
      <Canvas x:Name="UcsIcon" Width="70" Height="70" Margin="14,0,0,58" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
        <Path Data="M8,62 L8,10" Stroke="#5CB85C" StrokeThickness="2" />
        <Path Data="M3,16 L8,6 L13,16 Z" Fill="#5CB85C" />
        <Path Data="M8,62 L60,62" Stroke="#E05A5A" StrokeThickness="2" />
        <Path Data="M54,57 L64,62 L54,67 Z" Fill="#E05A5A" />
        <Rectangle Canvas.Left="4" Canvas.Top="58" Width="8" Height="8" Stroke="#C9CFD6" StrokeThickness="1.2" />
        <TextBlock Canvas.Left="14" Canvas.Top="0" Text="Y" FontSize="12" FontWeight="SemiBold" Foreground="#5CB85C" />
        <TextBlock Canvas.Left="58" Canvas.Top="40" Text="X" FontSize="12" FontWeight="SemiBold" Foreground="#E05A5A" />
      </Canvas>

      <!-- View cube (top view) -->
      <Grid x:Name="ViewCube" Width="110" Height="128" Margin="0,10,46,0" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Ellipse x:Name="CubeRing" Width="96" Height="96" VerticalAlignment="Top" Margin="0,2,0,0" StrokeThickness="9" Opacity="0.55" />
        <Border x:Name="CubeFace" Width="46" Height="46" VerticalAlignment="Top" Margin="0,27,0,0" BorderThickness="1" CornerRadius="1">
          <TextBlock x:Name="CubeText" Text="TOP" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="CubeN" Text="N" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0" />
        <TextBlock x:Name="CubeS" Text="S" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,86,0,0" />
        <TextBlock x:Name="CubeW" Text="W" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,43,0,0" />
        <TextBlock x:Name="CubeE" Text="E" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,43,6,0" />
        <Border x:Name="WcsBadge" VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="8,1" CornerRadius="2" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock x:Name="WcsText" Text="WCS" FontSize="10" />
            <FontIcon x:Name="WcsChevron" Glyph="&#xE70D;" FontSize="7" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Navigation bar -->
      <Border x:Name="NavBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,148,8,0" CornerRadius="2" BorderThickness="1" Padding="1">
        <RibbonToolBar x:Name="NavToolBar" Orientation="Vertical" ShowLabels="False" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="0">
          <RibbonButton Id="nav.wheel" Label="Full Navigation Wheel" Icon="{cad:CadIcon Name=Orbit}" />
          <RibbonToggleButton x:Name="NavPan" Id="nav.pan" Label="Pan" Icon="{cad:CadIcon Name=Pan}" />
          <RibbonSplitButton x:Name="NavZoom" Id="nav.zoomExtents" Label="Zoom Extents" Icon="{cad:CadIcon Name=ZoomExtents}" FollowLastChoice="True">
            <MenuFlyout>
              <MenuFlyoutItem Text="Zoom Extents" Tag="{cad:CadIcon Name=ZoomExtents}" />
              <MenuFlyoutItem Text="Zoom Window" Tag="{cad:CadIcon Name=ZoomWindow}" />
              <MenuFlyoutItem Text="Zoom In" Tag="{cad:CadIcon Name=ZoomWindow}" />
              <MenuFlyoutItem Text="Zoom Out" Tag="{cad:CadIcon Name=ZoomWindow}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonButton Id="nav.orbit" Label="Orbit" Icon="{cad:CadIcon Name=Orbit}" />
        </RibbonToolBar>
      </Border>

      <!-- Command line: history above a docked-in-canvas input, as in AutoCAD. -->
      <StackPanel x:Name="CommandLine" VerticalAlignment="Bottom" Margin="70,0,70,10" Spacing="0" MaxWidth="980">
        <Border x:Name="CommandHistoryBox" CornerRadius="2,2,0,0" Padding="10,4" HorizontalAlignment="Stretch">
          <TextBlock x:Name="CommandHistory" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="NoWrap" MaxLines="3" LineHeight="17" />
        </Border>
        <Border x:Name="CommandBar" Height="30" CornerRadius="2" BorderThickness="1">
          <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CommandClose" Style="{StaticResource RibbonChromeButtonStyle}" Width="22" Padding="0" Margin="2,0,0,0" AutomationProperties.Name="Close command line">
              <FontIcon Glyph="&#xE711;" FontSize="9" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource RibbonChromeButtonStyle}" Width="22" Padding="0" AutomationProperties.Name="Customize">
              <FontIcon Glyph="&#xE90F;" FontSize="11" />
            </Button>
            <TextBlock x:Name="CommandPrompt" Grid.Column="2" Text="&gt;_" FontFamily="Consolas,Menlo,monospace" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,1" />
            <TextBox x:Name="CommandInput" Grid.Column="3" PlaceholderText="Type a command" FontFamily="Consolas,Menlo,monospace" FontSize="12" VerticalAlignment="Center" BorderThickness="0" MinHeight="0" Padding="4,4,4,4" Background="Transparent" AutomationProperties.Name="Command line" />
            <Button Grid.Column="4" Style="{StaticResource RibbonChromeButtonStyle}" Width="24" Padding="0" Margin="0,0,2,0" AutomationProperties.Name="Recent commands">
              <FontIcon Glyph="&#xE70E;" FontSize="9" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>

    <!-- ============================ STATUS BAR ============================ -->
    <RibbonStatusBar x:Name="StatusBar" Grid.Row="4" MinHeight="30">
      <StackPanel x:Name="LayoutTabs" Orientation="Horizontal" Spacing="1" VerticalAlignment="Stretch" />
      <RibbonStatusBar.EndItems>
        <TextBlock x:Name="Coordinates" Text="6215.7290, 3820.4106, 0.0000" FontFamily="Consolas,Menlo,monospace" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
        <RibbonToggleButton x:Name="ModelToggle" Id="status.model" Label="MODEL" IsChecked="True" ScreenTip="Model or paper space" />
        <RibbonToggleButton x:Name="GridToggle" Id="status.grid" ShowLabel="False" Label="Display Drawing Grid" Icon="{cad:CadIcon Name=Grid}" IsChecked="True" Shortcut="F7" />
        <RibbonToggleButton Id="status.snap" ShowLabel="False" Label="Snap Mode" Icon="{cad:CadIcon Name=Snap}" Shortcut="F9" />
        <RibbonSeparator />
        <RibbonToggleButton Id="status.ortho" ShowLabel="False" Label="Ortho Mode" Icon="{cad:CadIcon Name=Ortho}" Shortcut="F8" />
        <RibbonToggleButton Id="status.polar" ShowLabel="False" Label="Polar Tracking" Icon="{cad:CadIcon Name=Polar}" IsChecked="True" Shortcut="F10" />
        <RibbonToggleButton Id="status.otrack" ShowLabel="False" Label="Object Snap Tracking" Icon="{cad:CadIcon Name=ObjectSnapTracking}" IsChecked="True" Shortcut="F11" />
        <RibbonSplitButton x:Name="OsnapButton" Id="status.osnap" ShowLabel="False" Label="Object Snap" Icon="{cad:CadIcon Name=ObjectSnap}" IsCheckable="True" IsChecked="True" Shortcut="F3">
          <MenuFlyout>
            <ToggleMenuFlyoutItem Text="Endpoint" IsChecked="True" />
            <ToggleMenuFlyoutItem Text="Midpoint" IsChecked="True" />
            <ToggleMenuFlyoutItem Text="Center" IsChecked="True" />
            <ToggleMenuFlyoutItem Text="Geometric Center" />
            <ToggleMenuFlyoutItem Text="Node" />
            <ToggleMenuFlyoutItem Text="Quadrant" />
            <ToggleMenuFlyoutItem Text="Intersection" IsChecked="True" />
            <ToggleMenuFlyoutItem Text="Extension" IsChecked="True" />
            <ToggleMenuFlyoutItem Text="Perpendicular" />
            <ToggleMenuFlyoutItem Text="Tangent" />
            <ToggleMenuFlyoutItem Text="Nearest" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Object Snap Settings..." />
          </MenuFlyout>
        </RibbonSplitButton>
        <RibbonSeparator />
        <RibbonToggleButton x:Name="LineweightToggle" Id="status.lwt" ShowLabel="False" Label="Show/Hide Lineweight" Icon="{cad:CadIcon Name=ShowLineweight}" />
        <RibbonToggleButton Id="status.transparency" ShowLabel="False" Label="Show/Hide Transparency" Icon="{cad:CadIcon Name=ShowTransparency}" />
        <RibbonToggleButton Id="status.selectionCycling" ShowLabel="False" Label="Selection Cycling" Icon="{cad:CadIcon Name=SelectionCycling}" />
        <RibbonSeparator />
        <RibbonDropDownButton Id="status.annoScale" Label="1:1" ScreenTip="Annotation scale of the current view" Icon="{cad:CadIcon Name=AnnotationScale}">
          <RibbonDropDownButton.Flyout>
            <MenuFlyout>
              <RadioMenuFlyoutItem Text="1:1" GroupName="annoScale" IsChecked="True" />
              <RadioMenuFlyoutItem Text="1:2" GroupName="annoScale" />
              <RadioMenuFlyoutItem Text="1:5" GroupName="annoScale" />
              <RadioMenuFlyoutItem Text="1:10" GroupName="annoScale" />
              <RadioMenuFlyoutItem Text="1:50" GroupName="annoScale" />
              <RadioMenuFlyoutItem Text="1:100" GroupName="annoScale" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Custom..." />
            </MenuFlyout>
          </RibbonDropDownButton.Flyout>
        </RibbonDropDownButton>
        <RibbonDropDownButton x:Name="WorkspaceStatusButton" Id="status.workspace" ShowLabel="False" Label="Workspace Switching" Icon="{cad:CadIcon Name=Workspace}" />
        <RibbonToggleButton x:Name="CleanScreenToggle" Id="status.cleanScreen" ShowLabel="False" Label="Clean Screen" Icon="{cad:CadIcon Name=CleanScreen}" Shortcut="Ctrl+0" />
        <RibbonButton Id="status.customize" ShowLabel="False" Label="Customization" Icon="&#xE700;" />
      </RibbonStatusBar.EndItems>
    </RibbonStatusBar>
  </Grid>
</UserControl>
