<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:RibbonSpace.Controls"
                    xmlns:p="using:RibbonSpace.Controls.Primitives">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///RibbonSpace.Uno/Themes/Shared.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ===================== RibbonButton / RibbonDropDownButton ===================== -->
  <Style x:Key="DefaultRibbonButtonStyle" TargetType="c:RibbonButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource RibbonForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="{ThemeResource RibbonControlCornerRadius}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonButton">
          <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemHoverBrush}" />
                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource RibbonItemBorderHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="PART_Content.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                    <Setter Target="PART_Content.IconForeground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <p:RibbonItemContent x:Name="PART_Content"
                                 Icon="{TemplateBinding Icon}"
                                 LargeIcon="{TemplateBinding LargeIcon}"
                                 Label="{TemplateBinding Label}"
                                 ItemSize="{TemplateBinding CurrentSize}"
                                 ShowLabel="{TemplateBinding ActualShowLabel}"
                                 ShowChevron="{TemplateBinding ShowChevron}"
                                 IsSimplified="{TemplateBinding IsSimplified}"
                                 Metrics="{TemplateBinding Metrics}"
                                 Foreground="{TemplateBinding Foreground}"
                                 IconForeground="{ThemeResource RibbonIconBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="c:RibbonButton" BasedOn="{StaticResource DefaultRibbonButtonStyle}" />
  <Style TargetType="c:RibbonDropDownButton" BasedOn="{StaticResource DefaultRibbonButtonStyle}" />

  <!-- ===================== RibbonToggleButton ===================== -->
  <Style TargetType="c:RibbonToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource RibbonForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="{ThemeResource RibbonControlCornerRadius}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonToggleButton">
          <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="PART_Content.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                    <Setter Target="PART_Content.IconForeground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemCheckedBrush}" />
                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource RibbonItemCheckedBorderBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemCheckedHoverBrush}" />
                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource RibbonItemCheckedBorderBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemPressedBrush}" />
                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource RibbonItemCheckedBorderBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemCheckedBrush}" />
                    <Setter Target="PART_Content.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                    <Setter Target="PART_Content.IconForeground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Indeterminate">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource RibbonItemCheckedBorderBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IndeterminatePointerOver">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IndeterminatePressed">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource RibbonItemPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IndeterminateDisabled">
                  <VisualState.Setters>
                    <Setter Target="PART_Content.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <p:RibbonItemContent x:Name="PART_Content"
                                 Icon="{TemplateBinding Icon}"
                                 LargeIcon="{TemplateBinding LargeIcon}"
                                 Label="{TemplateBinding Label}"
                                 ItemSize="{TemplateBinding CurrentSize}"
                                 ShowLabel="{TemplateBinding ActualShowLabel}"
                                 ShowChevron="{TemplateBinding ShowChevron}"
                                 IsSimplified="{TemplateBinding IsSimplified}"
                                 Metrics="{TemplateBinding Metrics}"
                                 Foreground="{TemplateBinding Foreground}"
                                 IconForeground="{ThemeResource RibbonIconBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== RibbonSplitButton ===================== -->
  <Style x:Key="DefaultRibbonSplitButtonStyle" TargetType="c:RibbonSplitButton">
    <Setter Property="Foreground" Value="{ThemeResource RibbonForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonSplitButton">
          <Grid x:Name="PART_Root" CornerRadius="{ThemeResource RibbonControlCornerRadius}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="PART_Root.Background" Value="{ThemeResource RibbonItemCheckedBrush}" />
                    <Setter Target="PART_Root.BorderBrush" Value="{ThemeResource RibbonItemCheckedBorderBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="OrientationStates">
                <VisualState x:Name="Vertical" />
                <VisualState x:Name="Horizontal" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="PART_PrimaryContent.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                    <Setter Target="PART_PrimaryContent.IconForeground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                    <Setter Target="PART_SecondaryContent.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                    <Setter Target="PART_SecondaryContent.IconForeground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="DropDownStates">
                <VisualState x:Name="DropDownClosed" />
                <VisualState x:Name="DropDownOpen">
                  <VisualState.Setters>
                    <Setter Target="PART_SecondaryButton.Background" Value="{ThemeResource RibbonItemPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Button x:Name="PART_PrimaryButton" Style="{StaticResource RibbonSplitPartButtonStyle}" Foreground="{TemplateBinding Foreground}">
              <p:RibbonItemContent x:Name="PART_PrimaryContent" IconForeground="{ThemeResource RibbonIconBrush}" Foreground="{TemplateBinding Foreground}" />
            </Button>
            <Button x:Name="PART_SecondaryButton" Style="{StaticResource RibbonSplitPartButtonStyle}" Foreground="{TemplateBinding Foreground}">
              <p:RibbonItemContent x:Name="PART_SecondaryContent" IconForeground="{ThemeResource RibbonIconBrush}" Foreground="{TemplateBinding Foreground}" />
            </Button>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="c:RibbonSplitButton" BasedOn="{StaticResource DefaultRibbonSplitButtonStyle}" />
  <Style TargetType="c:RibbonColorPicker" BasedOn="{StaticResource DefaultRibbonSplitButtonStyle}" />

  <!-- ===================== RibbonCheckBox ===================== -->
  <Style TargetType="c:RibbonCheckBox">
    <Setter Property="Foreground" Value="{ThemeResource RibbonForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0,6,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="{ThemeResource RibbonControlCornerRadius}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonCheckBox">
          <Grid x:Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <!-- Driven by RibbonCheckBox (independent of the CheckBox base states). -->
              <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="HoverNormal" />
                <VisualState x:Name="HoverPointerOver">
                  <VisualState.Setters>
                    <Setter Target="PART_Root.Background" Value="{ThemeResource RibbonItemHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="EnabledStates">
                <VisualState x:Name="ItemEnabled" />
                <VisualState x:Name="ItemDisabled">
                  <VisualState.Setters>
                    <Setter Target="PART_Label.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="14" Height="14" VerticalAlignment="Center">
              <Border x:Name="PART_Box" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource RibbonInputHoverBorderBrush}" Background="{ThemeResource RibbonInputBackgroundBrush}" />
              <FontIcon x:Name="PART_Check" Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource RibbonAccentForegroundBrush}" Visibility="Collapsed" />
              <Rectangle x:Name="PART_Indeterminate" Width="7" Height="2" Fill="{ThemeResource RibbonAccentForegroundBrush}" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="PART_Label" Grid.Column="1" Margin="6,0,0,0" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextLineBounds="Full" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== RibbonSeparator ===================== -->
  <Style TargetType="c:RibbonSeparator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonSeparator">
          <Rectangle x:Name="PART_Line" Fill="{ThemeResource RibbonSeparatorBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== RibbonLabel ===================== -->
  <Style TargetType="c:RibbonLabel">
    <Setter Property="Foreground" Value="{ThemeResource RibbonForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonLabel">
          <StackPanel Orientation="Horizontal" Spacing="5" Padding="4,0" Height="22">
            <p:RibbonIconPresenter Icon="{TemplateBinding Icon}" IconSize="16" Foreground="{ThemeResource RibbonIconBrush}" />
            <TextBlock Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== RibbonButtonGroup ===================== -->
  <Style TargetType="c:RibbonButtonGroup">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonButtonGroup">
          <StackPanel x:Name="PART_ItemsHost" Orientation="Horizontal" Spacing="0" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== RibbonStackPanel ===================== -->
  <Style TargetType="c:RibbonStackPanel">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonStackPanel">
          <StackPanel x:Name="PART_ItemsHost" Orientation="{TemplateBinding Orientation}" Spacing="{TemplateBinding Spacing}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== RibbonScreenTip ===================== -->
  <Style TargetType="c:RibbonScreenTip">
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonScreenTip">
          <StackPanel Spacing="6" Padding="2">
            <TextBlock Text="{TemplateBinding TitleText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <p:RibbonIconPresenter x:Name="PART_Image" Icon="{TemplateBinding Image}" IconSize="96" HorizontalAlignment="Left" Foreground="{ThemeResource RibbonIconBrush}" />
            <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}" TextWrapping="Wrap" Opacity="0.9" />
            <TextBlock x:Name="PART_DisabledReason" Text="{TemplateBinding DisabledReason}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />
            <!-- Progressive tooltip: shown after RibbonScreenTipService.ExtendedDelay. -->
            <StackPanel x:Name="PART_Extended" Spacing="6" Visibility="Collapsed" BorderThickness="0,1,0,0" Padding="0,6,0,0" BorderBrush="{ThemeResource RibbonSeparatorBrush}">
              <p:RibbonIconPresenter x:Name="PART_ExtendedImage" Icon="{TemplateBinding ExtendedImage}" IconSize="160" HorizontalAlignment="Left" Foreground="{ThemeResource RibbonIconBrush}" />
              <TextBlock x:Name="PART_ExtendedDescription" Text="{TemplateBinding ExtendedDescription}" TextWrapping="Wrap" Opacity="0.9" />
            </StackPanel>
            <StackPanel x:Name="PART_HelpText" Orientation="Horizontal" Spacing="6" BorderThickness="0,1,0,0" Padding="0,6,0,0" BorderBrush="{ThemeResource RibbonSeparatorBrush}">
              <FontIcon Glyph="&#xE897;" FontSize="12" />
              <TextBlock Text="{TemplateBinding HelpText}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
