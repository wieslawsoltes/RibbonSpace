<UserControl x:Class="RibbonSpace.Demo.Pages.CadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cad="using:RibbonSpace.Demo.Cad"
             RequestedTheme="Dark">
  <UserControl.Resources>
    <!-- AutoCAD-style layer drop-down: on / off, freeze / thaw, lock / unlock, colour, name. -->
    <DataTemplate x:Key="LayerItemTemplate" x:DataType="cad:CadLayer">
      <StackPanel Orientation="Horizontal" Spacing="3" Height="20">
        <RibbonIconPresenter Icon="{x:Bind OnIcon}" IconSize="16" Foreground="{ThemeResource RibbonIconBrush}" />
        <RibbonIconPresenter Icon="{x:Bind FreezeIcon}" IconSize="16" Foreground="{ThemeResource RibbonIconBrush}" />
        <RibbonIconPresenter Icon="{x:Bind LockIcon}" IconSize="16" Foreground="{ThemeResource RibbonIconBrush}" />
        <Border Width="12" Height="12" Margin="3,0,5,0" VerticalAlignment="Center" Background="{x:Bind ColorBrush}" BorderBrush="{ThemeResource RibbonSwatchBorderBrush}" BorderThickness="1" />
        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ColorItemTemplate" x:DataType="cad:CadColorOption">
      <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
        <Grid Width="14" Height="14" VerticalAlignment="Center">
          <Border Background="{x:Bind Swatch}" BorderBrush="{ThemeResource RibbonSwatchBorderBrush}" BorderThickness="1" />
          <Polygon Points="0,14 14,0 14,14" Fill="{ThemeResource RibbonSecondaryForegroundBrush}" Opacity="{x:Bind SpecialOpacity}" />
        </Grid>
        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LinetypeItemTemplate" x:DataType="cad:CadLinetype">
      <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
        <Line X1="0" X2="40" Y1="10" Y2="10" Width="40" VerticalAlignment="Center" Stroke="{ThemeResource RibbonForegroundBrush}" StrokeThickness="1.4" StrokeDashArray="{x:Bind Dashes}" />
        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LineweightItemTemplate" x:DataType="cad:CadLineweight">
      <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
        <Rectangle Width="40" Height="{x:Bind Thickness}" VerticalAlignment="Center" Fill="{ThemeResource RibbonForegroundBrush}" />
        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="Root" Background="{ThemeResource RibbonWindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ TITLE BAR ============================ -->
    <RibbonTitleBar x:Name="TitleBar" Title="Drawing1.dwg" Subtitle="RibbonSpace CAD" Height="38" SearchWidth="260" AppIcon="{cad:CadIcon Name=AppLogo}" IsAppIconMenuEnabled="True">
      <RibbonTitleBar.EndContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="SignIn" Padding="8,0" Height="28" AutomationProperties.Name="Sign in">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE77B;" FontSize="14" />
              <TextBlock Text="Sign In" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="HelpButton" Padding="6,0" Height="28" AutomationProperties.Name="Help" ToolTipService.ToolTip="Help (F1)">
            <RibbonIconPresenter Icon="{cad:CadIcon Name=Help}" IconSize="18" Foreground="{ThemeResource RibbonIconBrush}" />
          </Button>
        </StackPanel>
      </RibbonTitleBar.EndContent>
    </RibbonTitleBar>

    <!-- ============================ RIBBON ============================ -->
    <Ribbon x:Name="Ribbon"
            Grid.Row="1"
            Density="Compact"
            IsApplicationButtonVisible="False"
            IsDisplayOptionsButtonVisible="False"
            IsMinimizeButtonVisible="True"
            MinimizeBehavior="CycleAll"
            CanFloatGroups="True"
            IsVisibilityMenuEnabled="True"
            ReductionStrategy="GroupByGroup"
            IsShortcutRoutingEnabled="True">
      <Ribbon.ApplicationMenu>
        <Flyout x:Name="AppMenuFlyout" Placement="BottomEdgeAlignedLeft">
          <RibbonApplicationMenu x:Name="AppMenu" RecentHeader="Recent Documents">
            <RibbonApplicationMenuItem Id="new" Label="New" Icon="{cad:CadIcon Name=New}">
              <RibbonApplicationMenuItem Id="newDrawing" Label="Drawing" Description="Creates a new drawing from a template." />
              <RibbonApplicationMenuItem Id="newSheetSet" Label="Sheet Set" Description="Creates a new sheet set to organize layouts." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuItem Id="open" Label="Open" Icon="{cad:CadIcon Name=Open}">
              <RibbonApplicationMenuItem Id="openDrawing" Label="Drawing" Description="Opens an existing drawing file." />
              <RibbonApplicationMenuItem Id="openFromWeb" Label="From Web &amp; Mobile" Description="Opens a drawing stored in the cloud." />
              <RibbonApplicationMenuItem Id="openSheetSet" Label="Sheet Set" Description="Opens a sheet set data file." />
              <RibbonApplicationMenuItem Id="openDgn" Label="DGN" Description="Imports the data from a DGN file into a new drawing." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuItem Id="save" Label="Save" Icon="{cad:CadIcon Name=Save}" />
            <RibbonApplicationMenuItem x:Name="SaveAsItem" Id="saveAs" Label="Save As" Icon="{cad:CadIcon Name=SaveAs}">
              <RibbonApplicationMenuItem Id="saveAsDrawing" Label="Drawing" Icon="{cad:CadIcon Name=SaveAs}" Description="Saves the current drawing to a DWG file." />
              <RibbonApplicationMenuItem Id="saveAsTemplate" Label="Drawing Template" Icon="{cad:CadIcon Name=New}" Description="Creates a drawing template (DWT) file in which you can create new drawings." />
              <RibbonApplicationMenuItem Id="saveAsStandards" Label="Drawing Standards" Icon="{cad:CadIcon Name=Customize}" Description="Creates a drawing standards (DWS) file for checking drawings against standards." />
              <RibbonApplicationMenuItem Id="saveAsOther" Label="Other Formats" Icon="{cad:CadIcon Name=Save}" Description="Saves the current drawing in DWG, DWT, DWS or DXF file format." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuItem Id="import" Label="Import" Icon="{cad:CadIcon Name=ImportPdf}" HasSeparatorBefore="True">
              <RibbonApplicationMenuItem Id="importPdf" Label="PDF" Icon="{cad:CadIcon Name=ImportPdf}" Description="Imports the geometry, fills, raster images and text from a PDF file." />
              <RibbonApplicationMenuItem Id="importDgn" Label="DGN" Description="Imports the data from a DGN file into the current drawing." />
              <RibbonApplicationMenuItem Id="importOther" Label="Other Formats" Description="Imports files of various formats into the current drawing." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuItem Id="export" Label="Export" Icon="{cad:CadIcon Name=ExportPdf}">
              <RibbonApplicationMenuItem Id="exportPdf" Label="PDF" Icon="{cad:CadIcon Name=ExportPdf}" Description="Exports the current drawing or layouts to a PDF file." />
              <RibbonApplicationMenuItem Id="exportDwf" Label="DWF" Icon="{cad:CadIcon Name=Publish}" Description="Creates a DWF file and lets you set individual page setup overrides." />
              <RibbonApplicationMenuItem Id="exportDgn" Label="DGN" Description="Exports the current drawing to a DGN file." />
              <RibbonApplicationMenuItem Id="exportFbx" Label="FBX" Icon="{cad:CadIcon Name=Box}" Description="Exports 3D objects, cameras and lights to an FBX file." />
              <RibbonApplicationMenuItem Id="exportOther" Label="Other Formats" Description="Exports the drawing to other file formats." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuItem Id="publish" Label="Publish" Icon="{cad:CadIcon Name=Publish}">
              <RibbonApplicationMenuItem Id="publishShare" Label="Share View" Icon="{cad:CadIcon Name=Share}" Description="Publishes a design view of the drawing in a web browser." />
              <RibbonApplicationMenuItem Id="publishSend" Label="Send to 3D Print Service" Icon="{cad:CadIcon Name=Box}" Description="Sends a 3D model to a 3D printing service." />
              <RibbonApplicationMenuItem Id="publishArchive" Label="Archive" Description="Packages the current sheet set files for archiving." />
              <RibbonApplicationMenuItem Id="publishEtransmit" Label="eTransmit" Description="Creates a package of the drawing and its dependent files." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuItem Id="print" Label="Print" Icon="{cad:CadIcon Name=Plot}">
              <RibbonApplicationMenuItem Id="printPlot" Label="Plot" Icon="{cad:CadIcon Name=Plot}" Description="Plots a drawing to a plotter, printer or file." />
              <RibbonApplicationMenuItem Id="printBatch" Label="Batch Plot" Icon="{cad:CadIcon Name=BatchPlot}" Description="Publishes drawings to DWF, DWFx and PDF files, or to printers and plotters." />
              <RibbonApplicationMenuItem Id="printSetup" Label="Page Setup" Icon="{cad:CadIcon Name=PageSetup}" Description="Controls the page layout, plotting device, paper size and other settings for each new layout." />
              <RibbonApplicationMenuItem Id="printPreview" Label="Plot Preview" Icon="{cad:CadIcon Name=ZoomWindow}" Description="Displays the drawing as it will be plotted." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuItem Id="utilities" Label="Drawing Utilities" Icon="{cad:CadIcon Name=Units}" HasSeparatorBefore="True">
              <RibbonApplicationMenuItem Id="utilUnits" Label="Units" Icon="{cad:CadIcon Name=Units}" Description="Controls coordinate and angle display formats and precision." />
              <RibbonApplicationMenuItem Id="utilAudit" Label="Audit" Icon="{cad:CadIcon Name=QuickSelect}" Description="Evaluates the integrity of a drawing and corrects some errors." />
              <RibbonApplicationMenuItem Id="utilStatus" Label="Status" Icon="{cad:CadIcon Name=IdPoint}" Description="Displays drawing statistics, modes and extents." />
              <RibbonApplicationMenuItem Id="utilPurge" Label="Purge" Icon="{cad:CadIcon Name=Purge}" Description="Removes unused items, such as block definitions and layers, from the drawing." />
              <RibbonApplicationMenuItem Id="utilRecover" Label="Recover" Icon="{cad:CadIcon Name=Open}" Description="Repairs and then opens a damaged drawing file." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenuItem Id="close" Label="Close" Icon="{cad:CadIcon Name=Close}">
              <RibbonApplicationMenuItem Id="closeCurrent" Label="Current Drawing" Description="Closes the current drawing." />
              <RibbonApplicationMenuItem Id="closeAll" Label="All Drawings" Description="Closes all currently open drawings." />
            </RibbonApplicationMenuItem>
            <RibbonApplicationMenu.RecentItems>
              <RibbonApplicationMenuRecentItem Title="Floor Plan.dwg" Path="Projects › Riverside House" IsPinned="True" />
              <RibbonApplicationMenuRecentItem Title="Gearbox Housing.dwg" Path="Projects › Mechanical" IsPinned="True" />
              <RibbonApplicationMenuRecentItem Title="Site Layout.dwg" Path="Projects › Riverside House" />
              <RibbonApplicationMenuRecentItem Title="Bracket Detail.dwg" Path="Projects › Mechanical" />
              <RibbonApplicationMenuRecentItem Title="Electrical Plan.dwg" Path="Documents" />
            </RibbonApplicationMenu.RecentItems>
            <RibbonApplicationMenu.FooterItems>
              <Button x:Name="AppMenuOptions" Content="Options" MinWidth="80" />
              <Button x:Name="AppMenuExit" Content="Exit RibbonSpace CAD" />
            </RibbonApplicationMenu.FooterItems>
          </RibbonApplicationMenu>
        </Flyout>
      </Ribbon.ApplicationMenu>

      <Ribbon.QuickAccessToolBar>
        <RibbonQuickAccessToolBar>
          <RibbonButton Id="qat.new" Label="New" Icon="{cad:CadIcon Name=New}" Shortcut="Ctrl+N" />
          <RibbonButton Id="qat.open" Label="Open" Icon="{cad:CadIcon Name=Open}" Shortcut="Ctrl+O" />
          <RibbonButton Id="qat.save" Label="Save" Icon="{cad:CadIcon Name=Save}" Shortcut="Ctrl+S" />
          <RibbonButton Id="qat.saveAs" Label="Save As" Icon="{cad:CadIcon Name=SaveAs}" Shortcut="Ctrl+Shift+S" />
          <RibbonButton Id="qat.undo" Label="Undo" Icon="{cad:CadIcon Name=Undo}" Shortcut="Ctrl+Z" />
          <RibbonButton Id="qat.redo" Label="Redo" Icon="{cad:CadIcon Name=Redo}" Shortcut="Ctrl+Y" />
          <RibbonButton Id="qat.plot" Label="Plot" Icon="{cad:CadIcon Name=Plot}" Shortcut="Ctrl+P" />
          <RibbonComboBox x:Name="WorkspaceCombo" Id="qat.workspace" Label="Workspace" IsEditable="False" InputWidth="168" Text="Drafting &amp; Annotation" CanAddToQuickAccess="False">
            <x:String>Drafting &amp; Annotation</x:String>
            <x:String>3D Basics</x:String>
            <x:String>3D Modeling</x:String>
          </RibbonComboBox>
        </RibbonQuickAccessToolBar>
      </Ribbon.QuickAccessToolBar>

      <Ribbon.ContextualGroups>
        <RibbonContextualTabGroup Id="textEditor" Header="Text Editor" Color="#4CAF50" Activation="SelectOnShow" />
        <RibbonContextualTabGroup Id="hatchCreation" Header="Hatch Creation" Color="#3DA9F5" Activation="SelectOnShow" />
      </Ribbon.ContextualGroups>

      <!-- ============================ HOME ============================ -->
      <RibbonTab Header="Home" Id="home" KeyTip="H">
        <RibbonGroup x:Name="DrawGroup" Header="Draw" Id="draw" Icon="{cad:CadIcon Name=Line}" ScreenTip="Lines, circles, arcs, polylines and other basic geometry.">
          <RibbonButton Id="line" Label="Line" Icon="{cad:CadIcon Name=Line}" Size="Large" KeyTip="LI">
            <RibbonButton.ScreenTip>
              <RibbonScreenTip Title="Line" Description="Creates straight line segments.&#x0a;&#x0a;LINE" ExtendedDescription="With the LINE command, you can create a series of contiguous line segments. Each segment is a line object that can be edited separately. Specify the first point, then each next point; press Enter to end or type C to close the sequence." ExtendedImage="{cad:CadIcon Name=LineHelp}" HelpText="Press F1 for more help" />
            </RibbonButton.ScreenTip>
          </RibbonButton>
          <RibbonButton Id="polyline" Label="Polyline" Icon="{cad:CadIcon Name=Polyline}" Size="Large" KeyTip="PL">
            <RibbonButton.ScreenTip>
              <RibbonScreenTip Title="Polyline" Description="Creates a 2D polyline, a single object that is composed of line and arc segments.&#x0a;&#x0a;PLINE" ExtendedDescription="Switch between line and arc segments while drawing; set the width of each segment. Polylines can be edited, joined and offset as a single object." ExtendedImage="{cad:CadIcon Name=PolylineHelp}" HelpText="Press F1 for more help" />
            </RibbonButton.ScreenTip>
          </RibbonButton>
          <RibbonSplitButton Id="circle" Label="Circle" Icon="{cad:CadIcon Name=CircleCenterRadius}" Size="Large" FollowLastChoice="True" KeyTip="CI">
            <RibbonSplitButton.ScreenTip>
              <RibbonScreenTip Title="Circle" Description="Creates a circle using a center point and a radius.&#x0a;&#x0a;CIRCLE" ExtendedDescription="Pick the center point, then the radius. The drop-down offers diameter, 2-point, 3-point and tangent methods; the button keeps the method you used last." ExtendedImage="{cad:CadIcon Name=CircleHelp}" HelpText="Press F1 for more help" />
            </RibbonSplitButton.ScreenTip>
            <MenuFlyout>
              <MenuFlyoutItem Text="Center, Radius" Tag="{cad:CadIcon Name=CircleCenterRadius}" />
              <MenuFlyoutItem Text="Center, Diameter" Tag="{cad:CadIcon Name=CircleTwoPoint}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="2-Point" Tag="{cad:CadIcon Name=CircleTwoPoint}" />
              <MenuFlyoutItem Text="3-Point" Tag="{cad:CadIcon Name=CircleThreePoint}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Tan, Tan, Radius" Tag="{cad:CadIcon Name=CircleTanTanRadius}" />
              <MenuFlyoutItem Text="Tan, Tan, Tan" Tag="{cad:CadIcon Name=CircleTanTanTan}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonSplitButton Id="arc" Label="Arc" Icon="{cad:CadIcon Name=Arc}" Size="Large" FollowLastChoice="True" KeyTip="AC" ScreenTip="Creates an arc.&#x0a;&#x0a;ARC">
            <MenuFlyout>
              <MenuFlyoutItem Text="3-Point" Tag="{cad:CadIcon Name=Arc}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Start, Center, End" Tag="{cad:CadIcon Name=ArcStartCenterEnd}" />
              <MenuFlyoutItem Text="Start, Center, Angle" Tag="{cad:CadIcon Name=ArcStartCenterEnd}" />
              <MenuFlyoutItem Text="Start, Center, Length" Tag="{cad:CadIcon Name=ArcStartCenterEnd}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Start, End, Angle" Tag="{cad:CadIcon Name=Arc}" />
              <MenuFlyoutItem Text="Start, End, Direction" Tag="{cad:CadIcon Name=Arc}" />
              <MenuFlyoutItem Text="Start, End, Radius" Tag="{cad:CadIcon Name=Arc}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Continue" Tag="{cad:CadIcon Name=Arc}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonSplitButton Id="rectangle" Label="Rectangle" Icon="{cad:CadIcon Name=Rectangle}" Size="Small" FollowLastChoice="True" ScreenTip="Creates a rectangular polyline.&#x0a;&#x0a;RECTANG">
            <MenuFlyout>
              <MenuFlyoutItem Text="Rectangle" Tag="{cad:CadIcon Name=Rectangle}" />
              <MenuFlyoutItem Text="Polygon" Tag="{cad:CadIcon Name=Polygon}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonSplitButton Id="hatch" Label="Hatch" Icon="{cad:CadIcon Name=Hatch}" Size="Small" FollowLastChoice="True" KeyTip="H">
            <RibbonSplitButton.ScreenTip>
              <RibbonScreenTip Title="Hatch" Description="Fills an enclosed area or selected objects with a hatch pattern, solid fill or gradient fill.&#x0a;&#x0a;HATCH" ExtendedDescription="Click inside an area bounded by objects to pick it, or select the boundary objects. The Hatch Creation contextual tab opens with patterns, scale, angle and options." ExtendedImage="{cad:CadIcon Name=HatchHelp}" HelpText="Press F1 for more help" />
            </RibbonSplitButton.ScreenTip>
            <MenuFlyout>
              <MenuFlyoutItem Text="Hatch" Tag="{cad:CadIcon Name=Hatch}" />
              <MenuFlyoutItem Text="Gradient" Tag="{cad:CadIcon Name=Gradient}" />
              <MenuFlyoutItem Text="Boundary" Tag="{cad:CadIcon Name=Boundary}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonSplitButton Id="ellipse" Label="Ellipse" Icon="{cad:CadIcon Name=Ellipse}" Size="Small" FollowLastChoice="True" ScreenTip="Creates an ellipse or an elliptical arc.&#x0a;&#x0a;ELLIPSE">
            <MenuFlyout>
              <MenuFlyoutItem Text="Center" Tag="{cad:CadIcon Name=Ellipse}" />
              <MenuFlyoutItem Text="Axis, End" Tag="{cad:CadIcon Name=Ellipse}" />
              <MenuFlyoutItem Text="Elliptical Arc" Tag="{cad:CadIcon Name=EllipticalArc}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonGroup.SlideOutItems>
            <RibbonStackPanel>
              <RibbonButton Id="spline" Label="Spline Fit" Icon="{cad:CadIcon Name=Spline}" Size="Small" ScreenTip="Creates a smooth curve that passes through fit points.&#x0a;&#x0a;SPLINE" />
              <RibbonButton Id="constructionLine" Label="Construction Line" Icon="{cad:CadIcon Name=ConstructionLine}" Size="Small" ScreenTip="Creates a line of infinite length.&#x0a;&#x0a;XLINE" />
              <RibbonButton Id="ray" Label="Ray" Icon="{cad:CadIcon Name=Ray}" Size="Small" ScreenTip="Creates a line that starts at a point and continues to infinity.&#x0a;&#x0a;RAY" />
              <RibbonButton Id="multiplePoints" Label="Multiple Points" Icon="{cad:CadIcon Name=Point}" Size="Small" ScreenTip="Creates multiple point objects.&#x0a;&#x0a;POINT" />
              <RibbonButton Id="multiline" Label="Multiline" Icon="{cad:CadIcon Name=MultiLine}" Size="Small" ScreenTip="Creates multiple parallel lines.&#x0a;&#x0a;MLINE" />
            </RibbonStackPanel>
            <RibbonStackPanel>
              <RibbonButton Id="region" Label="Region" Icon="{cad:CadIcon Name=Region}" Size="Small" ScreenTip="Converts an object that encloses an area into a region object.&#x0a;&#x0a;REGION" />
              <RibbonButton Id="revisionCloud" Label="Revision Cloud" Icon="{cad:CadIcon Name=RevisionCloud}" Size="Small" ScreenTip="Creates or modifies a revision cloud.&#x0a;&#x0a;REVCLOUD" />
              <RibbonButton Id="donut" Label="Donut" Icon="{cad:CadIcon Name=Donut}" Size="Small" ScreenTip="Creates a filled circle or a wide ring.&#x0a;&#x0a;DONUT" />
              <RibbonButton Id="boundary" Label="Boundary" Icon="{cad:CadIcon Name=Boundary}" Size="Small" ScreenTip="Creates a region or a polyline from an enclosed area.&#x0a;&#x0a;BOUNDARY" />
              <RibbonButton Id="gradient" Label="Gradient" Icon="{cad:CadIcon Name=Gradient}" Size="Small" ScreenTip="Fills an enclosed area with a gradient fill.&#x0a;&#x0a;GRADIENT" />
            </RibbonStackPanel>
            <RibbonButton Id="divide" Label="Divide" Icon="{cad:CadIcon Name=Point}" Size="Medium" ScreenTip="Places point objects or blocks along an object at equal intervals.&#x0a;&#x0a;DIVIDE" />
          </RibbonGroup.SlideOutItems>
        </RibbonGroup>

        <RibbonGroup x:Name="ModifyGroup" Header="Modify" Id="modify" Icon="{cad:CadIcon Name=Move}" ScreenTip="Move, copy, rotate, trim, fillet, array and other editing tools.">
          <RibbonButton Id="move" Label="Move" Icon="{cad:CadIcon Name=Move}" Size="Medium" KeyTip="MV" ScreenTip="Moves objects a specified distance in a specified direction.&#x0a;&#x0a;MOVE" />
          <RibbonButton Id="copy" Label="Copy" Icon="{cad:CadIcon Name=Copy}" Size="Medium" KeyTip="CO" ScreenTip="Copies objects a specified distance in a specified direction.&#x0a;&#x0a;COPY" />
          <RibbonButton Id="stretch" Label="Stretch" Icon="{cad:CadIcon Name=Stretch}" Size="Medium" KeyTip="ST" ScreenTip="Stretches objects crossed by a selection window or polygon.&#x0a;&#x0a;STRETCH" />
          <RibbonButton Id="rotate" Label="Rotate" Icon="{cad:CadIcon Name=Rotate}" Size="Medium" KeyTip="RO" ScreenTip="Rotates objects around a base point.&#x0a;&#x0a;ROTATE" />
          <RibbonButton Id="mirror" Label="Mirror" Icon="{cad:CadIcon Name=Mirror}" Size="Medium" KeyTip="MI" ScreenTip="Creates a mirrored copy of selected objects.&#x0a;&#x0a;MIRROR" />
          <RibbonButton Id="scale" Label="Scale" Icon="{cad:CadIcon Name=Scale}" Size="Medium" KeyTip="SC" ScreenTip="Enlarges or reduces selected objects, keeping the proportions after scaling.&#x0a;&#x0a;SCALE" />
          <RibbonSplitButton Id="trim" Label="Trim" Icon="{cad:CadIcon Name=Trim}" Size="Medium" FollowLastChoice="True" KeyTip="TR">
            <RibbonSplitButton.ScreenTip>
              <RibbonScreenTip Title="Trim" Description="Trims objects to meet the edges of other objects.&#x0a;&#x0a;TRIM" ExtendedDescription="Select the portion of an object to trim: it is removed up to the nearest intersecting objects. Hold Shift to extend instead. Drag across several objects to trim them at once." ExtendedImage="{cad:CadIcon Name=TrimHelp}" HelpText="Press F1 for more help" />
            </RibbonSplitButton.ScreenTip>
            <MenuFlyout>
              <MenuFlyoutItem Text="Trim" Tag="{cad:CadIcon Name=Trim}" />
              <MenuFlyoutItem Text="Extend" Tag="{cad:CadIcon Name=Extend}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonSplitButton Id="fillet" Label="Fillet" Icon="{cad:CadIcon Name=Fillet}" Size="Medium" FollowLastChoice="True" KeyTip="F">
            <RibbonSplitButton.ScreenTip>
              <RibbonScreenTip Title="Fillet" Description="Rounds and fillets the edges of objects.&#x0a;&#x0a;FILLET" ExtendedDescription="Select two objects: an arc of the current fillet radius is created tangent to both, and the objects are trimmed or extended to meet it. A radius of 0 creates a sharp corner." ExtendedImage="{cad:CadIcon Name=FilletHelp}" HelpText="Press F1 for more help" />
            </RibbonSplitButton.ScreenTip>
            <MenuFlyout>
              <MenuFlyoutItem Text="Fillet" Tag="{cad:CadIcon Name=Fillet}" />
              <MenuFlyoutItem Text="Chamfer" Tag="{cad:CadIcon Name=Chamfer}" />
              <MenuFlyoutItem Text="Blend Curves" Tag="{cad:CadIcon Name=Blend}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonSplitButton Id="array" Label="Array" Icon="{cad:CadIcon Name=ArrayRectangular}" Size="Medium" FollowLastChoice="True" KeyTip="AR">
            <RibbonSplitButton.ScreenTip>
              <RibbonScreenTip Title="Rectangular Array" Description="Distributes object copies into any combination of rows, columns and levels.&#x0a;&#x0a;ARRAYRECT" ExtendedDescription="The array stays associative: drag its grips or use the Array contextual tab to change the number of rows and columns and their spacing." ExtendedImage="{cad:CadIcon Name=ArrayHelp}" HelpText="Press F1 for more help" />
            </RibbonSplitButton.ScreenTip>
            <MenuFlyout>
              <MenuFlyoutItem Text="Rectangular Array" Tag="{cad:CadIcon Name=ArrayRectangular}" />
              <MenuFlyoutItem Text="Path Array" Tag="{cad:CadIcon Name=ArrayPath}" />
              <MenuFlyoutItem Text="Polar Array" Tag="{cad:CadIcon Name=ArrayPolar}" />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonButton Id="erase" Label="Erase" Icon="{cad:CadIcon Name=Erase}" Size="Small" KeyTip="E" ScreenTip="Removes objects from a drawing.&#x0a;&#x0a;ERASE" />
          <RibbonButton Id="explode" Label="Explode" Icon="{cad:CadIcon Name=Explode}" Size="Small" KeyTip="X" ScreenTip="Breaks a compound object into its component objects.&#x0a;&#x0a;EXPLODE" />
          <RibbonButton Id="offset" Label="Offset" Icon="{cad:CadIcon Name=Offset}" Size="Small" KeyTip="O">
            <RibbonButton.ScreenTip>
              <RibbonScreenTip Title="Offset" Description="Creates concentric circles, parallel lines and parallel curves.&#x0a;&#x0a;OFFSET" ExtendedDescription="Specify the offset distance, select an object, then click on the side to offset. Repeat to create several parallel copies at the same distance." ExtendedImage="{cad:CadIcon Name=OffsetHelp}" HelpText="Press F1 for more help" />
            </RibbonButton.ScreenTip>
          </RibbonButton>
          <RibbonGroup.SlideOutItems>
