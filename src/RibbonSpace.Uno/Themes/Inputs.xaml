      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonSearchBox">
          <Border Background="{ThemeResource RibbonSearchBackgroundBrush}" BorderBrush="{ThemeResource RibbonSearchBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,0,4,0">
            <Grid>
