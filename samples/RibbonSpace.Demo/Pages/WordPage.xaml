<UserControl x:Class="RibbonSpace.Demo.Pages.WordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource RibbonWindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <RibbonTitleBar x:Name="TitleBar" Ribbon="{x:Bind Ribbon}" Title="Quarterly report" Subtitle="• Saved to this PC" AppIcon="&#xE8A5;">
      <RibbonTitleBar.StartContent>
        <ToggleSwitch x:Name="AutoSave" OnContent="AutoSave" OffContent="AutoSave" IsOn="True" MinWidth="0" Margin="4,0,0,0" />
      </RibbonTitleBar.StartContent>
      <RibbonTitleBar.EndContent>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource RibbonAccentBrush}">
            <TextBlock Text="WS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource RibbonAccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
      </RibbonTitleBar.EndContent>
    </RibbonTitleBar>

    <Ribbon x:Name="Ribbon" Grid.Row="1" IsShortcutRoutingEnabled="True">
      <Ribbon.QuickAccessToolBar>
        <RibbonQuickAccessToolBar>
          <RibbonButton Id="qat.save" Label="Save" Icon="&#xE74E;" Shortcut="Ctrl+S" />
          <RibbonButton Id="qat.undo" Label="Undo" Icon="&#xE7A7;" Shortcut="Ctrl+Z" />
          <RibbonButton Id="qat.redo" Label="Redo" Icon="&#xE7A6;" Shortcut="Ctrl+Y" />
        </RibbonQuickAccessToolBar>
      </Ribbon.QuickAccessToolBar>

      <Ribbon.Backstage>
        <RibbonBackstage Title="Word">
          <RibbonBackstageItem Id="home" Header="Home" Icon="&#xE80F;" KeyTip="H">
            <StackPanel Spacing="16">
              <TextBlock Text="Good afternoon" FontSize="20" />
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="150" Height="190" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource RibbonCommandBarBorderBrush}" Background="{ThemeResource RibbonCommandBarBackgroundBrush}">
                  <TextBlock Text="Blank document" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                </Border>
                <Border Width="150" Height="190" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource RibbonCommandBarBorderBrush}" Background="{ThemeResource RibbonAccentSubtleBrush}">
                  <TextBlock Text="Report" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                </Border>
                <Border Width="150" Height="190" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource RibbonCommandBarBorderBrush}" Background="{ThemeResource RibbonAccentSubtleStrongBrush}">
                  <TextBlock Text="Resume" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                </Border>
              </StackPanel>
              <TextBlock Text="Recent" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="Quarterly report.docx — Documents" Opacity="0.8" />
              <TextBlock Text="Product roadmap.docx — OneDrive" Opacity="0.8" />
            </StackPanel>
          </RibbonBackstageItem>
          <RibbonBackstageItem Id="new" Header="New" Icon="&#xE8A5;" KeyTip="N">
            <TextBlock Text="Choose a template to start a new document." />
          </RibbonBackstageItem>
          <RibbonBackstageItem Id="open" Header="Open" Icon="&#xE8E5;" KeyTip="O">
            <TextBlock Text="Browse recent files, OneDrive and this PC." />
          </RibbonBackstageItem>
          <RibbonBackstageItem Id="info" Header="Info" Icon="&#xE946;" HasSeparatorBefore="True" KeyTip="I">
            <StackPanel Spacing="8">
              <TextBlock Text="Protect Document" FontWeight="SemiBold" />
              <TextBlock Text="Control what types of changes people can make to this document." TextWrapping="Wrap" />
              <TextBlock Text="Inspect Document" FontWeight="SemiBold" Margin="0,12,0,0" />
              <TextBlock Text="Before publishing this file, be aware that it contains document properties and author's name." TextWrapping="Wrap" />
            </StackPanel>
          </RibbonBackstageItem>
          <RibbonBackstageItem x:Name="BackstageSave" Id="save" Header="Save" Icon="&#xE74E;" KeyTip="S" />
          <RibbonBackstageItem Id="saveAs" Header="Save As" Icon="&#xE792;" KeyTip="A">
            <TextBlock Text="Save a copy of this document." />
          </RibbonBackstageItem>
          <RibbonBackstageItem Id="print" Header="Print" Icon="&#xE749;" KeyTip="P">
            <TextBlock Text="Print preview and printer settings." />
          </RibbonBackstageItem>
          <RibbonBackstageItem Id="export" Header="Export" Icon="&#xEDE1;" KeyTip="E">
            <TextBlock Text="Create PDF/XPS documents or change the file type." />
          </RibbonBackstageItem>
          <RibbonBackstageItem Id="close" Header="Close" Icon="&#xE8BB;" KeyTip="C" />
          <RibbonBackstageItem Id="account" Header="Account" Icon="&#xE77B;" Placement="Bottom">
            <TextBlock Text="Signed in as a demo user." />
          </RibbonBackstageItem>
          <RibbonBackstageItem Id="options" Header="Options" Icon="&#xE713;" Placement="Bottom">
            <TextBlock Text="Customize RibbonSpace options." />
          </RibbonBackstageItem>
        </RibbonBackstage>
      </Ribbon.Backstage>

      <Ribbon.ContextualGroups>
        <RibbonContextualTabGroup Id="table" Header="Table Tools" Color="#0F7B6C" Activation="SelectOnShow" />
        <RibbonContextualTabGroup Id="picture" Header="Picture Tools" Color="#8764B8" />
      </Ribbon.ContextualGroups>

      <Ribbon.TabStripItems>
        <RibbonButton Id="comments" Label="Comments" Icon="&#xE90A;" ShowLabel="True" SimplifiedLabel="Show" />
        <RibbonDropDownButton Id="editingMode" Label="Editing" Icon="&#xE70F;" SimplifiedLabel="Show">
          <RibbonDropDownButton.Flyout>
            <MenuFlyout>
              <RadioMenuFlyoutItem Text="Editing" GroupName="mode" IsChecked="True" />
              <RadioMenuFlyoutItem Text="Reviewing" GroupName="mode" />
              <RadioMenuFlyoutItem Text="Viewing" GroupName="mode" />
            </MenuFlyout>
          </RibbonDropDownButton.Flyout>
        </RibbonDropDownButton>
        <RibbonSplitButton Id="share" Label="Share" Icon="&#xE72D;" Size="Small" SimplifiedLabel="Show">
          <MenuFlyout>
            <MenuFlyoutItem Text="Share" />
            <MenuFlyoutItem Text="Copy link" />
            <MenuFlyoutItem Text="Send a copy" />
          </MenuFlyout>
        </RibbonSplitButton>
      </Ribbon.TabStripItems>

      <!-- ============================ HOME ============================ -->
      <RibbonTab Header="Home" Id="home" KeyTip="H">
        <RibbonGroup Header="Clipboard" Id="clipboard" Icon="&#xE77F;" IsDialogLauncherVisible="True" ReductionOrder="-1">
          <RibbonSplitButton Id="paste" Label="Paste" Icon="&#xE77F;" SizeDefinition="Large" Shortcut="Ctrl+V" KeyTip="V">
            <RibbonSplitButton.ScreenTip>
              <RibbonScreenTip Title="Paste" Shortcut="Ctrl+V" Description="Add content from the Clipboard to your document." HelpText="Tell me more" />
            </RibbonSplitButton.ScreenTip>
            <MenuFlyout>
              <MenuFlyoutItem Text="Keep Source Formatting" />
              <MenuFlyoutItem Text="Merge Formatting" />
              <MenuFlyoutItem Text="Keep Text Only" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Paste Special..." />
              <MenuFlyoutItem Text="Set Default Paste..." />
            </MenuFlyout>
          </RibbonSplitButton>
          <RibbonButton Id="cut" Label="Cut" Icon="&#xE8C6;" Shortcut="Ctrl+X" KeyTip="X" />
          <RibbonButton Id="copy" Label="Copy" Icon="&#xE8C8;" Shortcut="Ctrl+C" KeyTip="C" />
          <RibbonToggleButton Id="formatPainter" Label="Format Painter" Icon="&#xE771;" Size="Medium" KeyTip="FP" ScreenTip="Apply the look of one selection to other content." />
        </RibbonGroup>

        <RibbonGroup Header="Font" Id="font" Icon="&#xE8D2;" ItemsLayout="Rows" RowCount="2" IsDialogLauncherVisible="True">
          <RibbonStackPanel>
            <RibbonFontComboBox x:Name="FontFamily" Id="fontFamily" Text="Segoe UI" KeyTip="FF" />
            <RibbonFontSizeComboBox x:Name="FontSize" Id="fontSize" Text="16" KeyTip="FS" />
            <RibbonButtonGroup>
              <RibbonButton Id="growFont" Label="Increase Font Size" Icon="&#xE8E8;" Shortcut="Ctrl+]" KeyTip="FG" />
              <RibbonButton Id="shrinkFont" Label="Decrease Font Size" Icon="&#xE8E7;" Shortcut="Ctrl+[" KeyTip="FK" />
            </RibbonButtonGroup>
            <RibbonDropDownButton Id="changeCase" Label="Change Case" Icon="Aa" Size="Small" KeyTip="7">
              <RibbonDropDownButton.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Sentence case." />
                  <MenuFlyoutItem Text="lowercase" />
                  <MenuFlyoutItem Text="UPPERCASE" />
                  <MenuFlyoutItem Text="Capitalize Each Word" />
                  <MenuFlyoutItem Text="tOGGLE cASE" />
                </MenuFlyout>
              </RibbonDropDownButton.Flyout>
            </RibbonDropDownButton>
            <RibbonButton Id="clearFormatting" Label="Clear All Formatting" Icon="&#xE8E6;" Size="Small" KeyTip="E" />
          </RibbonStackPanel>
          <RibbonStackPanel>
            <RibbonButtonGroup>
              <RibbonToggleButton x:Name="Bold" Id="bold" Label="Bold" Icon="&#xE8DD;" Shortcut="Ctrl+B" KeyTip="1" ScreenTip="Make your text bold." />
              <RibbonToggleButton x:Name="Italic" Id="italic" Label="Italic" Icon="&#xE8DB;" Shortcut="Ctrl+I" KeyTip="2" ScreenTip="Italicize your text." />
              <RibbonToggleButton x:Name="Underline" Id="underline" Label="Underline" Icon="&#xE8DC;" Shortcut="Ctrl+U" KeyTip="3" ScreenTip="Underline your text." />
              <RibbonToggleButton x:Name="Strike" Id="strikethrough" Label="Strikethrough" Icon="&#xEDE0;" KeyTip="4" />
              <RibbonToggleButton Id="subscript" Label="Subscript" Icon="M3 5h2.5l3 4.5 3-4.5H14l-4.2 6.2L14 18h-2.5l-3-4.5-3 4.5H3l4.2-6.3z M16 16h4v1.5l-2.2 1.5H20V21h-4v-1.5l2.2-1.5H16z" GroupName="script" Shortcut="Ctrl+=" KeyTip="5" />
              <RibbonToggleButton Id="superscript" Label="Superscript" Icon="&#xEF19;" GroupName="script" Shortcut="Ctrl+Shift+=" KeyTip="6" />
            </RibbonButtonGroup>
            <RibbonColorPicker x:Name="Highlight" Id="highlight" Label="Text Highlight Color" Icon="&#xE7E6;" SelectedColor="Yellow" ShowNoColor="True" KeyTip="I" />
            <RibbonColorPicker x:Name="FontColor" Id="fontColor" Label="Font Color" Icon="&#xE8D3;" SelectedColor="#C00000" KeyTip="FC" />
          </RibbonStackPanel>
        </RibbonGroup>

        <RibbonGroup Header="Paragraph" Id="paragraph" Icon="&#xE8FD;" ItemsLayout="Rows" RowCount="2" IsDialogLauncherVisible="True">
          <RibbonStackPanel>
            <RibbonSplitButton Id="bullets" Label="Bullets" Icon="&#xE8FD;" Size="Small" IsCheckable="True" KeyTip="U">
              <MenuFlyout>
                <MenuFlyoutItem Text="• Bullet" />
                <MenuFlyoutItem Text="○ Circle" />
                <MenuFlyoutItem Text="■ Square" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Define New Bullet..." />
              </MenuFlyout>
            </RibbonSplitButton>
            <RibbonSplitButton Id="numbering" Label="Numbering" Icon="M9 5h12v2H9z M9 11h12v2H9z M9 17h12v2H9z M4 3h2v5H5V4.2H4z M3.5 10h3v1.3l-1.6 1.5h1.6V14h-3v-1.3l1.6-1.5H3.5z M3.5 16h3v5h-3v-1.1h1.9v-.9H4v-1h1.4v-.9H3.5z" Size="Small" IsCheckable="True" KeyTip="N" />
            <RibbonButtonGroup>
              <RibbonButton Id="outdent" Label="Decrease Indent" Icon="M3 4h18v2H3z M11 9h10v2H11z M11 13h10v2H11z M3 18h18v2H3z M7 8.5v7L3 12z" KeyTip="AO" />
              <RibbonButton Id="indent" Label="Increase Indent" Icon="M3 4h18v2H3z M11 9h10v2H11z M11 13h10v2H11z M3 18h18v2H3z M3 8.5l4 3.5-4 3.5z" KeyTip="AI" />
            </RibbonButtonGroup>
            <RibbonButton Id="sort" Label="Sort" Icon="&#xE8CB;" Size="Small" KeyTip="SO" />
            <RibbonToggleButton x:Name="ShowMarks" Id="showMarks" Label="Show/Hide ¶" Icon="¶" Shortcut="Ctrl+Shift+8" KeyTip="8" />
          </RibbonStackPanel>
          <RibbonStackPanel>
            <RibbonButtonGroup>
              <RibbonToggleButton x:Name="AlignLeft" Id="alignLeft" Label="Align Left" Icon="&#xE8E4;" GroupName="align" IsChecked="True" Shortcut="Ctrl+L" KeyTip="AL" />
              <RibbonToggleButton x:Name="AlignCenter" Id="alignCenter" Label="Center" Icon="&#xE8E3;" GroupName="align" Shortcut="Ctrl+E" KeyTip="AC" />
              <RibbonToggleButton x:Name="AlignRight" Id="alignRight" Label="Align Right" Icon="&#xE8E2;" GroupName="align" Shortcut="Ctrl+R" KeyTip="AR" />
              <RibbonToggleButton x:Name="Justify" Id="justify" Label="Justify" Icon="&#xE8E1;" GroupName="align" Shortcut="Ctrl+J" KeyTip="AJ" />
            </RibbonButtonGroup>
            <RibbonDropDownButton Id="lineSpacing" Label="Line and Paragraph Spacing" Icon="&#xE9E9;" Size="Small" KeyTip="K">
              <RibbonDropDownButton.Flyout>
                <MenuFlyout>
                  <RadioMenuFlyoutItem Text="1.0" GroupName="spacing" />
                  <RadioMenuFlyoutItem Text="1.15" GroupName="spacing" IsChecked="True" />
                  <RadioMenuFlyoutItem Text="1.5" GroupName="spacing" />
                  <RadioMenuFlyoutItem Text="2.0" GroupName="spacing" />
                </MenuFlyout>
              </RibbonDropDownButton.Flyout>
            </RibbonDropDownButton>
            <RibbonColorPicker x:Name="Shading" Id="shading" Label="Shading" Icon="&#xE790;" SelectedColor="#DEEBF7" ShowNoColor="True" ShowAutomatic="False" KeyTip="H" />
            <RibbonSplitButton Id="borders" Label="Borders" Icon="&#xE80A;" Size="Small" KeyTip="B" />
          </RibbonStackPanel>
        </RibbonGroup>

        <RibbonGroup Header="Styles" Id="styles" Icon="&#xE790;" IsDialogLauncherVisible="True" ReductionOrder="1">
          <RibbonGallery x:Name="Styles" Id="stylesGallery" Label="Styles" Icon="&#xE790;" MaxColumns="6" MinColumns="3" ItemWidth="76" IsFilterEnabled="True" KeyTip="L">
            <RibbonGalleryItem Label="Normal" Value="Normal" PreviewText="AaBbCcDd" Category="Paragraph" />
            <RibbonGalleryItem Label="No Spacing" Value="NoSpacing" PreviewText="AaBbCcDd" Category="Paragraph" />
            <RibbonGalleryItem Label="Heading 1" Value="Heading1" PreviewText="AaBbCc" PreviewFontSize="17" PreviewForeground="#2F5496" Category="Headings" />
            <RibbonGalleryItem Label="Heading 2" Value="Heading2" PreviewText="AaBbCcD" PreviewFontSize="15" PreviewForeground="#2F5496" Category="Headings" />
            <RibbonGalleryItem Label="Title" Value="Title" PreviewText="AaB" PreviewFontSize="22" Category="Headings" />
            <RibbonGalleryItem Label="Subtitle" Value="Subtitle" PreviewText="AaBbCcDd" PreviewForeground="#595959" Category="Headings" />
            <RibbonGalleryItem Label="Emphasis" Value="Emphasis" PreviewText="AaBbCcDd" PreviewFontStyle="Italic" Category="Character" />
            <RibbonGalleryItem Label="Strong" Value="Strong" PreviewText="AaBbCcDd" PreviewFontWeight="Bold" Category="Character" />
            <RibbonGalleryItem Label="Quote" Value="Quote" PreviewText="AaBbCcDd" PreviewFontStyle="Italic" PreviewForeground="#404040" Category="Paragraph" />
            <RibbonGalleryItem Label="Intense Quote" Value="IntenseQuote" PreviewText="AaBbCcDd" PreviewFontStyle="Italic" PreviewForeground="#2F5496" Category="Paragraph" />
            <RibbonGallery.FooterItems>
              <RibbonButton Label="Create a Style" Icon="&#xE710;" />
              <RibbonButton Label="Clear Formatting" Icon="&#xE8E6;" />
              <RibbonButton Label="Apply Styles..." Icon="&#xE790;" />
            </RibbonGallery.FooterItems>
          </RibbonGallery>
        </RibbonGroup>

        <RibbonGroup Header="Editing" Id="editing" Icon="&#xE721;">
          <RibbonDropDownButton Id="find" Label="Find" Icon="&#xE721;" KeyTip="FD">
            <RibbonDropDownButton.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Find" KeyboardAcceleratorTextOverride="Ctrl+F" />
                <MenuFlyoutItem Text="Advanced Find..." />
                <MenuFlyoutItem Text="Go To..." KeyboardAcceleratorTextOverride="Ctrl+G" />
              </MenuFlyout>
            </RibbonDropDownButton.Flyout>
          </RibbonDropDownButton>
          <RibbonButton Id="replace" Label="Replace" Icon="&#xE8AB;" Shortcut="Ctrl+H" KeyTip="R" />
          <RibbonDropDownButton Id="select" Label="Select" Icon="&#xE8B3;" KeyTip="SL">
            <RibbonDropDownButton.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Select All" KeyboardAcceleratorTextOverride="Ctrl+A" />
                <MenuFlyoutItem Text="Select Objects" />
                <MenuFlyoutItem Text="Selection Pane..." />
              </MenuFlyout>
            </RibbonDropDownButton.Flyout>
          </RibbonDropDownButton>
        </RibbonGroup>

        <RibbonGroup Header="Voice" Id="voice" Icon="&#xE720;">
          <RibbonSplitButton Id="dictate" Label="Dictate" Icon="&#xE720;" KeyTip="D" />
        </RibbonGroup>
        <RibbonGroup Header="Editor" Id="editor" Icon="&#xE8FB;">
          <RibbonButton Id="editorPane" Label="Editor" Icon="&#xE8FB;" Size="Large" KeyTip="G" />
        </RibbonGroup>
      </RibbonTab>

      <!-- ============================ INSERT ============================ -->
      <RibbonTab Header="Insert" Id="insert" KeyTip="N">
        <RibbonGroup Header="Pages" Id="pages" Icon="&#xE7C3;">
          <RibbonDropDownButton Id="coverPage" Label="Cover Page" Icon="&#xE7C3;" Size="Large" />
          <RibbonButton Id="blankPage" Label="Blank Page" Icon="&#xE8A5;" Size="Large" />
          <RibbonButton Id="pageBreak" Label="Page Break" Icon="&#xE7C3;" Size="Large" Shortcut="Ctrl+Enter" />
        </RibbonGroup>
        <RibbonGroup Header="Tables" Id="tables" Icon="&#xE80A;">
          <RibbonDropDownButton x:Name="InsertTable" Id="insertTable" Label="Table" Icon="&#xE80A;" Size="Large" KeyTip="T">
            <RibbonDropDownButton.Flyout>
              <Flyout>
                <RibbonGridPicker x:Name="TablePicker" />
              </Flyout>
            </RibbonDropDownButton.Flyout>
          </RibbonDropDownButton>
        </RibbonGroup>
        <RibbonGroup Header="Illustrations" Id="illustrations" Icon="&#xEB9F;">
          <RibbonDropDownButton Id="pictures" Label="Pictures" Icon="&#xEB9F;" Size="Large" />
          <RibbonDropDownButton Id="shapes" Label="Shapes" Icon="&#xE91B;" Size="Large" />
          <RibbonButton Id="icons" Label="Icons" Icon="&#xED58;" Size="Large" />
          <RibbonButton Id="models3d" Label="3D Models" Icon="&#xE7B8;" />
          <RibbonButton Id="smartArt" Label="SmartArt" Icon="&#xE9D2;" />
          <RibbonButton Id="chart" Label="Chart" Icon="&#xE9D2;" />
          <RibbonDropDownButton Id="screenshot" Label="Screenshot" Icon="&#xE722;" />
        </RibbonGroup>
        <RibbonGroup Header="Media" Id="media" Icon="&#xE714;">
          <RibbonButton Id="onlineVideo" Label="Online Videos" Icon="&#xE714;" Size="Large" />
        </RibbonGroup>
        <RibbonGroup Header="Links" Id="links" Icon="&#xE71B;">
          <RibbonButton Id="link" Label="Link" Icon="&#xE71B;" Shortcut="Ctrl+K" />
          <RibbonButton Id="bookmark" Label="Bookmark" Icon="&#xE8A4;" />
          <RibbonButton Id="crossReference" Label="Cross-reference" Icon="&#xE8AD;" />
        </RibbonGroup>
        <RibbonGroup Header="Comments" Id="insertComments" Icon="&#xE90A;">
          <RibbonButton Id="newComment" Label="Comment" Icon="&#xE90A;" Size="Large" Shortcut="Ctrl+Alt+M" />
        </RibbonGroup>
        <RibbonGroup Header="Header &amp; Footer" Id="headerFooter" Icon="&#xE8A1;">
          <RibbonDropDownButton Id="header" Label="Header" Icon="&#xE8A1;" />
          <RibbonDropDownButton Id="footer" Label="Footer" Icon="&#xE8A1;" />
          <RibbonDropDownButton Id="pageNumber" Label="Page Number" Icon="&#xE8A1;" />
        </RibbonGroup>
        <RibbonGroup Header="Text" Id="text" Icon="&#xE8D2;">
          <RibbonDropDownButton Id="textBox" Label="Text Box" Icon="&#xE8D2;" Size="Large" />
          <RibbonButton Id="quickParts" Label="Quick Parts" Icon="&#xECAA;" />
          <RibbonButton Id="wordArt" Label="WordArt" Icon="&#xE8D2;" />
          <RibbonButton Id="dropCap" Label="Drop Cap" Icon="&#xE8D2;" />
        </RibbonGroup>
        <RibbonGroup Header="Symbols" Id="symbols" Icon="&#xE94C;">
          <RibbonSplitButton Id="equation" Label="Equation" Icon="&#xE94C;" Shortcut="Alt+=" />
          <RibbonDropDownButton Id="symbol" Label="Symbol" Icon="Ω" />
        </RibbonGroup>
      </RibbonTab>

      <!-- ============================ DESIGN ============================ -->
      <RibbonTab Header="Design" Id="design" KeyTip="D">
        <RibbonGroup Header="Document Formatting" Id="docFormatting" Icon="&#xE790;">
          <RibbonDropDownButton Id="themes" Label="Themes" Icon="&#xE790;" Size="Large" />
          <RibbonGallery x:Name="ThemeGallery" Id="styleSets" Label="Style Set" MaxColumns="5" MinColumns="3" ItemWidth="70" ItemHeight="62" ShowItemLabels="False">
            <RibbonGalleryItem Label="Office" PreviewText="Title" PreviewFontSize="16" PreviewBackground="#FFFFFF" />
            <RibbonGalleryItem Label="Basic" PreviewText="Title" PreviewFontSize="16" PreviewForeground="#1F3864" PreviewBackground="#F2F2F2" />
            <RibbonGalleryItem Label="Lines" PreviewText="Title" PreviewFontSize="16" PreviewForeground="#C55A11" PreviewBackground="#FBE5D6" />
            <RibbonGalleryItem Label="Shaded" PreviewText="Title" PreviewFontSize="16" PreviewForeground="#FFFFFF" PreviewBackground="#2F5496" />
            <RibbonGalleryItem Label="Casual" PreviewText="Title" PreviewFontSize="16" PreviewForeground="#375623" PreviewBackground="#E2EFDA" />
            <RibbonGalleryItem Label="Lines (Stylish)" PreviewText="Title" PreviewFontSize="16" PreviewForeground="#7030A0" PreviewBackground="#EDE0F5" />
          </RibbonGallery>
          <RibbonDropDownButton Id="colors" Label="Colors" Icon="&#xE790;" />
          <RibbonDropDownButton Id="fonts" Label="Fonts" Icon="&#xE8D2;" />
          <RibbonDropDownButton Id="paragraphSpacing" Label="Paragraph Spacing" Icon="&#xE9E9;" />
          <RibbonCheckBox Id="setAsDefault" Label="Set as Default" />
        </RibbonGroup>
        <RibbonGroup Header="Page Background" Id="pageBackground" Icon="&#xE790;">
          <RibbonDropDownButton Id="watermark" Label="Watermark" Icon="&#xE8D2;" Size="Large" />
          <RibbonColorPicker x:Name="PageColor" Id="pageColor" Label="Page Color" Icon="&#xE790;" Size="Large" SelectedColor="White" ShowNoColor="True" ShowAutomatic="False" />
          <RibbonButton Id="pageBorders" Label="Page Borders" Icon="&#xE80A;" Size="Large" />
        </RibbonGroup>
      </RibbonTab>

      <!-- ============================ LAYOUT ============================ -->
      <RibbonTab Header="Layout" Id="layout" KeyTip="P">
        <RibbonGroup Header="Page Setup" Id="pageSetup" Icon="&#xE7C3;" IsDialogLauncherVisible="True">
          <RibbonDropDownButton Id="margins" Label="Margins" Icon="&#xE7C3;" Size="Large">
            <RibbonDropDownButton.Flyout>
              <MenuFlyout>
                <RadioMenuFlyoutItem Text="Normal" GroupName="margins" IsChecked="True" />
                <RadioMenuFlyoutItem Text="Narrow" GroupName="margins" />
                <RadioMenuFlyoutItem Text="Moderate" GroupName="margins" />
                <RadioMenuFlyoutItem Text="Wide" GroupName="margins" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Custom Margins..." />
              </MenuFlyout>
            </RibbonDropDownButton.Flyout>
          </RibbonDropDownButton>
          <RibbonDropDownButton Id="orientation" Label="Orientation" Icon="&#xE7C3;" Size="Large" />
          <RibbonDropDownButton Id="size" Label="Size" Icon="&#xE7C3;" Size="Large" />
          <RibbonDropDownButton Id="columns" Label="Columns" Icon="&#xE8A9;" Size="Large" />
