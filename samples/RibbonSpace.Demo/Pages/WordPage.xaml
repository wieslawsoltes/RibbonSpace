    <!-- Document -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
      <Grid Padding="24">
        <Border x:Name="PageSheet" RequestedTheme="Light" Width="760" MinHeight="760" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White" CornerRadius="2" Padding="72,64" BorderThickness="1" BorderBrush="#20000000">
          <StackPanel Spacing="14">
            <TextBlock x:Name="DocTitle" Text="Quarterly report" FontSize="30" Foreground="#1F3864" />
            <TextBlock x:Name="DocText" TextWrapping="Wrap" FontSize="16" Foreground="#242424" Text="RibbonSpace brings a modern, Office-style ribbon to Uno Platform. Select text styles, fonts, colors and alignment in the ribbon to format this paragraph. Hover the Styles gallery for live preview, press Alt for KeyTips, Alt+Q for search, Ctrl+F1 to collapse the ribbon, or right-click any command to add it to the Quick Access Toolbar." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ToggleTable" Content="Select a table (shows Table Tools)" />
              <Button x:Name="ToggleDark" Content="Toggle dark mode" />
            </StackPanel>
            <Border x:Name="TableSample" Visibility="Collapsed" BorderThickness="1" BorderBrush="#4472C4" CornerRadius="2">
              <Grid ColumnSpacing="1" RowSpacing="1" Background="#4472C4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Border Background="#4472C4" Padding="8"><TextBlock Text="Region" Foreground="White" FontWeight="SemiBold" /></Border>
                <Border Grid.Column="1" Background="#4472C4" Padding="8"><TextBlock Text="Q3" Foreground="White" FontWeight="SemiBold" /></Border>
                <Border Grid.Column="2" Background="#4472C4" Padding="8"><TextBlock Text="Q4" Foreground="White" FontWeight="SemiBold" /></Border>
                <Border Grid.Row="1" Background="#DEEBF7" Padding="8"><TextBlock Text="North" Foreground="#242424" /></Border>
                <Border Grid.Row="1" Grid.Column="1" Background="#DEEBF7" Padding="8"><TextBlock Text="1.2M" Foreground="#242424" /></Border>
                <Border Grid.Row="1" Grid.Column="2" Background="#DEEBF7" Padding="8"><TextBlock Text="1.5M" Foreground="#242424" /></Border>
                <Border Grid.Row="2" Background="White" Padding="8"><TextBlock Text="South" Foreground="#242424" /></Border>
                <Border Grid.Row="2" Grid.Column="1" Background="White" Padding="8"><TextBlock Text="0.9M" Foreground="#242424" /></Border>
                <Border Grid.Row="2" Grid.Column="2" Background="White" Padding="8"><TextBlock Text="1.1M" Foreground="#242424" /></Border>
              </Grid>
            </Border>
            <TextBlock x:Name="LastCommand" Opacity="0.6" FontSize="12" Foreground="#424242" Text="Last command: —" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <RibbonStatusBar Grid.Row="3">
      <TextBlock Text="Page 1 of 1" VerticalAlignment="Center" />
      <TextBlock x:Name="WordCount" Text="64 words" VerticalAlignment="Center" />
      <TextBlock Text="English (United States)" VerticalAlignment="Center" />
      <RibbonStatusBar.EndItems>
        <RibbonButton Label="Focus" Icon="&#xE740;" />
        <RibbonToggleButton Label="Read Mode" Icon="&#xE736;" GroupName="statusView" />
        <RibbonToggleButton Label="Print Layout" Icon="&#xE7C3;" GroupName="statusView" IsChecked="True" />
        <RibbonToggleButton Label="Web Layout" Icon="&#xE774;" GroupName="statusView" />
        <RibbonZoomControl x:Name="Zoom" Value="100" />
      </RibbonStatusBar.EndItems>
    </RibbonStatusBar>
  </Grid>
</UserControl>
