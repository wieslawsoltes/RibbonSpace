<UserControl x:Class="RibbonSpace.Demo.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rs="using:RibbonSpace.Controls">
  <Grid Background="{ThemeResource RibbonWindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Classic menu bar (ImageSpace / VideoSpace / CadSpace style). -->
    <rs:RibbonMenuBar x:Name="MenuBar">
      <rs:RibbonMenuBarItem Header="File">
        <MenuFlyoutItem Text="New..." KeyboardAcceleratorTextOverride="Ctrl+N" />
        <MenuFlyoutItem Text="Open..." KeyboardAcceleratorTextOverride="Ctrl+O" />
        <MenuFlyoutSubItem Text="Open Recent">
          <MenuFlyoutItem Text="poster.psd" />
          <MenuFlyoutItem Text="logo.svg" />
        </MenuFlyoutSubItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Save" KeyboardAcceleratorTextOverride="Ctrl+S" />
        <MenuFlyoutItem Text="Export As..." KeyboardAcceleratorTextOverride="Alt+Shift+Ctrl+W" />
      </rs:RibbonMenuBarItem>
      <rs:RibbonMenuBarItem Header="Edit">
        <MenuFlyoutItem Text="Undo" KeyboardAcceleratorTextOverride="Ctrl+Z" />
        <MenuFlyoutItem Text="Redo" KeyboardAcceleratorTextOverride="Shift+Ctrl+Z" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Cut" KeyboardAcceleratorTextOverride="Ctrl+X" />
        <MenuFlyoutItem Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" />
        <MenuFlyoutItem Text="Paste" KeyboardAcceleratorTextOverride="Ctrl+V" />
      </rs:RibbonMenuBarItem>
      <rs:RibbonMenuBarItem Header="Image">
        <MenuFlyoutItem Text="Image Size..." />
        <MenuFlyoutItem Text="Canvas Size..." />
        <ToggleMenuFlyoutItem Text="Pixel Aspect Ratio Correction" IsChecked="True" />
      </rs:RibbonMenuBarItem>
      <rs:RibbonMenuBarItem Header="Layer">
        <MenuFlyoutItem Text="New Layer" KeyboardAcceleratorTextOverride="Shift+Ctrl+N" />
        <MenuFlyoutItem Text="Duplicate Layer" />
      </rs:RibbonMenuBarItem>
      <rs:RibbonMenuBarItem Header="View">
        <ToggleMenuFlyoutItem Text="Rulers" IsChecked="True" KeyboardAcceleratorTextOverride="Ctrl+R" />
        <ToggleMenuFlyoutItem Text="Grid" />
        <ToggleMenuFlyoutItem Text="Snap" IsChecked="True" />
      </rs:RibbonMenuBarItem>
      <rs:RibbonMenuBarItem Header="Window">
        <ToggleMenuFlyoutItem Text="Layers" IsChecked="True" />
        <ToggleMenuFlyoutItem Text="Properties" IsChecked="True" />
      </rs:RibbonMenuBarItem>
      <rs:RibbonMenuBarItem Header="Help">
        <MenuFlyoutItem Text="Keyboard Shortcuts" />
        <MenuFlyoutItem Text="About" />
      </rs:RibbonMenuBarItem>
    </rs:RibbonMenuBar>

    <!-- Tool options bar: content follows the active tool (Photoshop / Illustrator control bar). -->
    <rs:RibbonContextualToolBar x:Name="Options" Grid.Row="1" ActiveContext="brush" Margin="6,4">
      <rs:RibbonToolBar rs:RibbonContextualToolBar.Context="move" CornerRadius="6">
        <rs:RibbonLabel Label="Move" Icon="&#xE7C2;" />
        <rs:RibbonSeparator />
        <rs:RibbonCheckBox Label="Auto-Select" IsChecked="True" />
        <rs:RibbonCheckBox Label="Show Transform Controls" />
        <rs:RibbonSeparator />
        <rs:RibbonButton Label="Align Left" Icon="&#xE8E4;" />
        <rs:RibbonButton Label="Align Center" Icon="&#xE8E3;" />
        <rs:RibbonButton Label="Align Right" Icon="&#xE8E2;" />
      </rs:RibbonToolBar>
      <rs:RibbonToolBar rs:RibbonContextualToolBar.Context="brush" CornerRadius="6">
        <rs:RibbonLabel Label="Brush" Icon="&#xE771;" />
        <rs:RibbonSeparator />
        <rs:RibbonSpinner Label="Size:" Value="24" Minimum="1" Maximum="5000" Unit="px" InputWidth="70" />
        <rs:RibbonSpinner Label="Hardness:" Value="80" Minimum="0" Maximum="100" Unit="%" InputWidth="62" />
        <rs:RibbonComboBox Label="Mode" ShowLabel="True" Text="Normal" InputWidth="110">
          <x:String>Normal</x:String>
          <x:String>Multiply</x:String>
          <x:String>Screen</x:String>
          <x:String>Overlay</x:String>
        </rs:RibbonComboBox>
        <rs:RibbonSlider Label="Opacity" Value="100" Maximum="100" InputWidth="100" />
        <rs:RibbonToggleButton Label="Airbrush" Icon="&#xE706;" />
        <rs:RibbonToggleButton Label="Pressure for size" Icon="&#xEDFB;" />
        <rs:RibbonColorPicker Label="Brush color" Icon="&#xE790;" SelectedColor="#1473E6" />
      </rs:RibbonToolBar>
      <rs:RibbonToolBar rs:RibbonContextualToolBar.Context="text" CornerRadius="6">
        <rs:RibbonLabel Label="Type" Icon="&#xE8D2;" />
        <rs:RibbonSeparator />
        <rs:RibbonFontComboBox Text="Inter" />
        <rs:RibbonFontSizeComboBox Text="24" />
        <rs:RibbonButtonGroup>
          <rs:RibbonToggleButton Label="Bold" Icon="&#xE8DD;" />
          <rs:RibbonToggleButton Label="Italic" Icon="&#xE8DB;" />
        </rs:RibbonButtonGroup>
        <rs:RibbonSegmentedControl Label="Alignment">
          <rs:RibbonSegment Icon="&#xE8E4;" Label="Left" />
          <rs:RibbonSegment Icon="&#xE8E3;" Label="Center" />
          <rs:RibbonSegment Icon="&#xE8E2;" Label="Right" />
        </rs:RibbonSegmentedControl>
      </rs:RibbonToolBar>
    </rs:RibbonContextualToolBar>

    <Grid Grid.Row="2" ColumnSpacing="6" Padding="6,0,6,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Two-column vertical tool palette with radio tools and split tools. -->
      <rs:RibbonToolBar x:Name="Tools" Orientation="Vertical" Columns="2" VerticalAlignment="Top">
        <rs:RibbonToggleButton Label="Move (V)" Icon="&#xE7C2;" GroupName="tool" Tag="move" Shortcut="V" />
        <rs:RibbonToggleButton Label="Select (M)" Icon="&#xE8B3;" GroupName="tool" Tag="move" />
        <rs:RibbonToggleButton Label="Brush (B)" Icon="&#xE771;" GroupName="tool" Tag="brush" IsChecked="True" />
        <rs:RibbonToggleButton Label="Pen (P)" Icon="&#xEDFB;" GroupName="tool" Tag="brush" />
        <rs:RibbonToggleButton Label="Eraser (E)" Icon="&#xE75C;" GroupName="tool" Tag="brush" />
        <rs:RibbonToggleButton Label="Type (T)" Icon="&#xE8D2;" GroupName="tool" Tag="text" />
        <rs:RibbonSeparator />
        <rs:RibbonSplitButton Label="Rectangle" Icon="&#xE739;" Size="Small" FollowLastChoice="True">
          <MenuFlyout>
            <MenuFlyoutItem Text="Rectangle" Tag="&#xE739;" />
            <MenuFlyoutItem Text="Ellipse" Tag="&#xEA3A;" />
            <MenuFlyoutItem Text="Polygon" Tag="&#xE879;" />
            <MenuFlyoutItem Text="Line" Tag="&#xE7C9;" />
          </MenuFlyout>
        </rs:RibbonSplitButton>
        <rs:RibbonButton Label="Crop" Icon="&#xE7A8;" />
        <rs:RibbonButton Label="Zoom" Icon="&#xE71E;" />
        <rs:RibbonButton Label="Hand" Icon="&#xE7C9;" />
        <rs:RibbonSeparator />
        <rs:RibbonColorPicker Label="Foreground" Icon="&#xE790;" SelectedColor="#1473E6" />
        <rs:RibbonColorPicker Label="Background" Icon="&#xE790;" SelectedColor="White" />
      </rs:RibbonToolBar>

      <Border Grid.Column="1" CornerRadius="6" Background="#FF3A3A3A" BorderThickness="1" BorderBrush="{ThemeResource RibbonCommandBarBorderBrush}">
        <Grid>
          <Border Width="480" Height="320" Background="White" CornerRadius="2">
            <TextBlock x:Name="CanvasText" Text="Pick a tool — the options bar follows the active tool" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555555" />
          </Border>
          <!-- Horizontal command bar with overflow ("⋯") floating on the canvas. -->
          <rs:RibbonToolBar VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" MaxWidth="360">
            <rs:RibbonButton Label="Undo" Icon="&#xE7A7;" />
            <rs:RibbonButton Label="Redo" Icon="&#xE7A6;" />
            <rs:RibbonSeparator />
            <rs:RibbonButton Label="Zoom In" Icon="&#xE8A3;" />
            <rs:RibbonButton Label="Zoom Out" Icon="&#xE71F;" />
            <rs:RibbonButton Label="Fit" Icon="&#xE740;" />
            <rs:RibbonSeparator />
            <rs:RibbonToggleButton Label="Grid" Icon="&#xE80A;" />
            <rs:RibbonToggleButton Label="Snap" Icon="&#xE8AD;" IsChecked="True" />
            <rs:RibbonToggleButton Label="Rulers" Icon="&#xECC6;" />
            <rs:RibbonButton Label="Rotate" Icon="&#xE7AD;" />
            <rs:RibbonButton Label="Flip" Icon="&#xE8AB;" />
            <rs:RibbonButton Label="Export" Icon="&#xEDE1;" />
          </rs:RibbonToolBar>
        </Grid>
      </Border>

      <!-- Activity rail (panel launchers) with labels. -->
      <rs:RibbonToolBar Grid.Column="2" Orientation="Vertical" VerticalAlignment="Top">
        <rs:RibbonToggleButton Label="Layers" Icon="&#xE81E;" GroupName="panel" IsChecked="True" />
        <rs:RibbonToggleButton Label="Properties" Icon="&#xE713;" GroupName="panel" />
        <rs:RibbonToggleButton Label="History" Icon="&#xE81C;" GroupName="panel" />
        <rs:RibbonToggleButton Label="Libraries" Icon="&#xE8F1;" GroupName="panel" />
      </rs:RibbonToolBar>
    </Grid>

    <rs:RibbonStatusBar Grid.Row="3">
      <TextBlock x:Name="ToolStatus" Text="Brush tool" VerticalAlignment="Center" />
      <TextBlock Text="1920 × 1080 px · RGB/8" VerticalAlignment="Center" />
      <rs:RibbonStatusBar.EndItems>
        <rs:RibbonZoomControl Value="66" />
      </rs:RibbonStatusBar.EndItems>
    </rs:RibbonStatusBar>
  </Grid>
</UserControl>
